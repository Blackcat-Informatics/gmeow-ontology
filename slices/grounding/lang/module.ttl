# --- GMN dialect crossings (four judged translation units) -------------------- #
# Each crossing between dialect levels is a lang:TranslationUnit carrying its
# law-spine on exactly one logic:Correspondence; the preservation judgment
# lives THERE, never asserted flat on the sign systems. All four crossings are
# grammar-directed conversions (lang:methodCompositional) — the crossing is
# defined by the dialect's grammars and codecs, while any individual model-
# performed compaction run carries its own provenance on its GmnCompaction
# record.

gmeow:gmnCorrNormalToGts
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN-0 → GTS correspondence"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The judged crossing from the GMN-0 narrow-waist normal form to its GTS encoding: an isomorphism with exact preservation and a retained mnemomorphic witness. The claim is DISCHARGED by execution, not declared on faith: the narrow-waist superset gate re-derives the normal form from the encoded bundle and proves byte reconstruction on every regeneration, so get ∘ put = id is a running check, not prose."@x-gmeow-english ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Equiv ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:gmnCorrNormalToGtsGet .

# The crossing's authored get-leg witness (the supersession-ledger pattern): a
# one-step forward relation whose derived put is discharged by execution in the
# logic-compile stage's authored-correspondence gate, so the Isomorphism rung is
# a structurally-checked witness rather than an unchecked prose claim.
gmeow:gmnCorrNormalToGtsGet gmeow:path gmeow:gmnCorrNormalToGtsStep .

gmeow:gmnUnitNormalToGts
    a lang:TranslationUnit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN-0 → GTS crossing"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The dialect crossing from the GMN-0 normal form to the GTS encoding, a grammar-directed conversion carrying its law-spine on gmeow:gmnCorrNormalToGts."@x-gmeow-english ;
    lang:translationSource gmeow:gmnNormalForm ;
    lang:translationTarget lang:gts ;
    lang:translationMethod lang:methodCompositional ;
    lang:translationCorrespondence gmeow:gmnCorrNormalToGts .

gmeow:gmnCorrNormalToNQuads
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN-0 → N-Quads correspondence"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The judged crossing from the GMN-0 narrow-waist normal form to its canonical N-Quads encoding: an isomorphism with exact preservation and a retained mnemomorphic witness. The claim is discharged by the RDFC-1.0 canonicalization round-trip: canonicalizing the parsed N-Quads reproduces the normal form's canonical labeling and quad order byte-for-byte, so the crossing's inverse is an executed computation rather than an assertion."@x-gmeow-english ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Equiv ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:gmnCorrNormalToNQuadsGet .

# The crossing's authored get-leg witness (see gmeow:gmnCorrNormalToGtsGet).
gmeow:gmnCorrNormalToNQuadsGet gmeow:path gmeow:gmnCorrNormalToNQuadsStep .

gmeow:gmnUnitNormalToNQuads
    a lang:TranslationUnit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN-0 → N-Quads crossing"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The dialect crossing from the GMN-0 normal form to the canonical N-Quads encoding, a grammar-directed conversion carrying its law-spine on gmeow:gmnCorrNormalToNQuads."@x-gmeow-english ;
    lang:translationSource gmeow:gmnNormalForm ;
    lang:translationTarget lang:nquads ;
    lang:translationMethod lang:methodCompositional ;
    lang:translationCorrespondence gmeow:gmnCorrNormalToNQuads .

gmeow:gmnCorrNormalToGmn
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN-0 → GMN-1 correspondence"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The judged crossing from the GMN-0 normal form to the GMN-1 model notation: a section/retraction with exact preservation and a retained mnemomorphic witness — put ∘ get = id_S on the normal form, NOT the top logic:Isomorphism rung, because GMN-1 need not recover the exact GMN-0 BYTE serialization, only the underlying model (get ∘ put is idempotent on the view plus its in-band complement, not required to reproduce byte-identical GMN-1 text). The drop list from the prior lossy-lens declaration is ELIMINATED, not merely reduced: full IRIs invert through the codebook's version-pinned alias bijection (gmeow:gmnDictionaryVersion witnesses which alias table an alias resolves through); confidence and every annotation (per-term guidance prose, changelog and provenance notes) ride BY REFERENCE — the record carries an alias or record identifier pointing at the canonical confidence- or annotation-bearing statement, never inlined digits or prose, so the crossing's losslessness never rests on the two-fractional-digit assertion policy (a canon-precision quantization alone would not make the crossing lossless: the product t-norm of two 2-digit confidences is 4-digit, and re-quantizing a derived confidence breaks associativity). The only non-image of the crossing is an uncovered term, typed lang:GmnUncoveredTerm — a HARD FAIL at emit time, never a silent drop. Domain of this mnemomorphic-true claim: the ENTIRE GMN-0 normal form, realized as a convergent coverage contract rather than a narrowed claim — the codec + round-trip gate are total over the grounding slices' GMN-0 (logic, lang, math), hard-failing on any uncovered grounding construct; full coverage of every other slice's GMN-0 vocabulary is measured and gated by the GMN-1 coverage slice-quality axis at a committed floor with monotonic non-regression, never silently assumed complete — an uncovered non-grounding term is a MEASURED quality deficit, never a silent drop. This declaration's honesty is discharged by the executed byte-teeth round-trip gate being green, verified at the full make check: a projected LegPath *Step verdict alone is necessary but not sufficient to establish a Section-Retraction — a Step verdict can hold while the retraction it composes into still fails, so only the executed round-trip gate closes that gap. The alias table itself is a BIJECTION over its covered term set: no two distinct terms of one dictionary/alias table share an alias (injectivity, gated structurally — see lang:GmnDictionaryAliasCollision), and an alias is version-pinned, resolving through exactly one gmeow:gmnDictionaryVersion, never interchangeable across versions."@x-gmeow-english ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:gmnCorrNormalToGmnGet .

# The crossing's authored get-leg witness (see gmeow:gmnCorrNormalToGtsGet): a
# one-step forward relation whose derived put is discharged by execution in the
# executed GMN-1 round-trip gate, so the SectionRetraction rung is a
# structurally-checked witness rather than an unchecked prose claim.
gmeow:gmnCorrNormalToGmnGet gmeow:path gmeow:gmnCorrNormalToGmnStep .

gmeow:gmnUnitNormalToGmn
    a lang:TranslationUnit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN-0 → GMN-1 crossing"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The dialect crossing from the GMN-0 normal form to the GMN-1 model notation, a grammar-directed, codebook-witnessed conversion carrying its law-spine on gmeow:gmnCorrNormalToGmn."@x-gmeow-english ;
    lang:translationSource gmeow:gmnNormalForm ;
    lang:translationTarget gmeow:gmnModelNotation ;
    lang:translationMethod lang:methodCompositional ;
    lang:translationCorrespondence gmeow:gmnCorrNormalToGmn .

gmeow:gmnCorrGmnToCompacted
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN-1 → GMN-2 correspondence"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The judged crossing from GMN-1 to the GMN-2 compacted usage level: a bridge view, validation-only — the module's own honest label for bridge views that constrain but do not reason. Compaction produces a NEW provenance-linked claim (a gmeow:GmnCompaction naming its sources through gmeow:gmnCompacts); the crossing is get-leg-only, with no round-trip obligation and no recoverability witness, and its determinacy is vague because what a compaction keeps is a judgment call held on the compaction's own standpoint."@x-gmeow-english ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:hasDeterminacy logic:Vague ;
    logic:mnemomorphic false .

gmeow:gmnUnitGmnToCompacted
    a lang:TranslationUnit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN-1 → GMN-2 crossing"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The dialect crossing from GMN-1 to its GMN-2 compacted usage level, a grammar-directed conversion discipline (individual compaction runs carry their own provenance on their gmeow:GmnCompaction records) carrying its law-spine on gmeow:gmnCorrGmnToCompacted."@x-gmeow-english ;
    lang:translationSource gmeow:gmnModelNotation ;
    lang:translationTarget gmeow:gmnCompacted ;
    lang:translationMethod lang:methodCompositional ;
    lang:translationCorrespondence gmeow:gmnCorrGmnToCompacted .

# --- GMN dialect version machinery -------------------------------------------- #
# The dialect lineage is a gmeow:VersionSet with reified memberships, per the
# versions-slice doctrine. gmeow:membershipAuthority is optional on the relator
# (competing authority claims coexist; none is required), and no in-repo
# authority individual exists, so the memberships here carry none.

gmeow:gmnDialectVersions
    a owl:NamedIndividual , gmeow:VersionSet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN dialect lineage"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The version lineage of the GMN dialect: the gmeow:VersionSet its majors belong to through gmeow:VersionMembership relators. Carries the lineage-level acceptance policy gmeow:gmnAcceptWindow 1 — a conforming reader accepts the current major plus one prior (current + N−1), every accepted prior entering only through a judged gmeow:gmnMigratesFrom / gmeow:gmnMigratesTo crossing."@x-gmeow-english ;
    gmeow:gmnAcceptWindow 1 .

gmeow:gmnVersionOne
    a owl:NamedIndividual , gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN dialect version 1"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "Major version 1 of the GMN dialect — the concrete version entity (a gmeow:InformationObject) the lineage's memberships place. The first major: it is both the canonical and the latest member of gmeow:gmnDialectVersions."@x-gmeow-english ;
    owl:versionInfo "1" .

gmeow:gmnMembershipCanonical
    a owl:NamedIndividual , gmeow:VersionMembership ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN v1 canonical membership"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The reified claim that GMN dialect version 1 is the canonical member of the GMN dialect lineage."@x-gmeow-english ;
    gmeow:versionMember gmeow:gmnVersionOne ;
    gmeow:versionSet gmeow:gmnDialectVersions ;
    gmeow:versionRole gmeow:roleCanonical .

gmeow:gmnMembershipLatest
    a owl:NamedIndividual , gmeow:VersionMembership ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN v1 latest membership"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The reified claim that GMN dialect version 1 is the latest member of the GMN dialect lineage."@x-gmeow-english ;
    gmeow:versionMember gmeow:gmnVersionOne ;
    gmeow:versionSet gmeow:gmnDialectVersions ;
    gmeow:versionRole gmeow:roleLatest .

# --- GMN conformance-failure vocabulary (typed, queryable violation objects) -- #
# The thirteen hard rules of the GMN dialect, each a typed lang: failure class
# under lang:LangConformanceFailure. The first eight are enforced by the SHACL
# gates in shapes.ttl (each shape naming its class through
# gmeow:enforcesFailureClass); the last five are the GMN parser/writer's own
# validator tier — the rules a table-driven reader/writer checks against the
# codebook, grammar, and dictionary state that SHACL cannot see.

lang:GmnNonCanonicalCodepoint
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Non-Canonical Codepoint"@x-gmeow-english ;
    skos:definition "The failure raised when a glyph of the GMN script does not carry a canonical codepoint-explicit spelling: a lang:Grapheme in gmeow:gmnScript whose gmeow:gmnCodepoints is absent, or any gmeow:gmnCodepoints value that does not match the canonical \"U+XXXX\"-style form (uppercase hexadecimal, four to six digits, space-separated for multi-codepoint glyphs). The GMN glyph table is codepoint-explicit by rule — a glyph named only by its rendered shape is unauditable for confusables and collisions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnConfusableGlyph
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Confusable Glyph"@x-gmeow-english ;
    skos:definition "The failure raised when two distinct graphemes of gmeow:gmnScript are related by gmeow:gmnConfusableWith — a visually-confusable pair admitted into one glyph inventory. The GMN orthography's confusables blocklist forbids co-resident confusables: the normative rule is the Unicode UTS #39 skeleton (two glyphs are confusable iff they share a skeleton), the seeded gmeow:gmnConfusableWith pairs are its data-level anchors, and the full skeleton computation is the GMN validator's, never hand-curated completeness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnGlyphCollision
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Glyph Collision"@x-gmeow-english ;
    skos:definition "The failure raised when two distinct graphemes of one lang:Script share an identical gmeow:gmnCodepoints value without both being sigil-scoped: one codepoint sequence, two glyph identities, no gmeow:gmnSigilScope disambiguation on each. The single lawful reuse is the record-initial sigil discipline — the same glyph may read differently across GMN planes exactly when each reading pins its record scope through gmeow:gmnSigilScope (μ the math sigil versus μ the in-record measure symbol); an unscoped collision is ambiguity in the glyph table itself."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnMissingEnvelopeField
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Missing Envelope Field"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:GmnEnvelope omits any field of its nine-field contract: the three dialect coordinates (gmeow:gmnSchemaVersion, gmeow:gmnDictionaryVersion, gmeow:gmnGlyphTableVersion), its declared codebook identity (gmeow:gmnCodebookDigest), its boundary ring (gmeow:gmnSecurityRing), its asserting standpoint (gmeow:accordingTo), its generating activity (gmeow:wasGeneratedBy), its byte-exact identity (gmeow:contentDigest), and its losslessness judgment (gmeow:gmnEnvelopeCorrespondence). An envelope is the attested carrier of a payload across a serialization boundary; a carrier missing any contract field cannot be admitted, migrated, or audited. The same shape also fires this class when an envelope declares MORE than one gmeow:gmnDictionaryVersion or gmeow:gmnSecurityRing — a version-pinned coordinate that is not exactly one is as ill-formed as one that is absent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnDictionaryAliasCollision
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Dictionary Alias Collision"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:GmnDictionary's alias table is not injective: two of its gmeow:GmnDictionaryEntry members bind two DIFFERENT gmeow:gmnDictionaryEntryTerm values to the SAME gmeow:gmnDictionaryEntryAlias string. gmeow:gmnCorrNormalToGmn's mnemomorphic claim rests on the dictionary being a genuine bijection over its covered term set; a shared alias makes read-back ambiguous — the reader cannot tell which of the two terms an occurrence of the alias names — silently corrupting the section/retraction witness. Distinct from lang:GmnUncoveredTerm (an alias the dictionary does not mint at all) and from lang:GmnUndeclaredDialectVersion (no pinned dictionary version to resolve against)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnRingLatticeMalformed
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Ring Lattice Malformed"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:GmnSecurityRing's AUTHORED lattice coordinates are ill-formed: it carries no gmeow:gmnRingLevel (or more than one), or a gmeow:gmnRingCompartment value that is not a declared gmeow:GmnCompartment individual. This gates the coordinates the gmeow:gmnRingWithin derivation reads FROM, not the derived relation itself — gating the derived relation for partial-order-ness would be a tautology, since a derivation from a partial order is trivially one. A ring with malformed coordinates cannot be placed in the lattice at all."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnVersionOverclaim
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Version Overclaim"@x-gmeow-english ;
    skos:definition "The failure raised when the GMN version machinery claims more than its lineage discharges: a migration crossing (gmeow:gmnMigratesFrom / gmeow:gmnMigratesTo) whose correspondence claims logic:mnemomorphic true while the destination version's membership carries a change scale stronger than additive (anything other than gmeow:scaleMinor or gmeow:scaleTrivial — a major or breaking bump has, by its own classification, changed what a round-trip could recover), or a gmeow:gmnAcceptWindow greater than 1 (acceptance beyond current-plus-one-prior is silent tolerance, not judged migration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnCompactionWithoutProvenance
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Compaction Without Provenance"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:GmnCompaction is not fully provenance-linked: it names no source through gmeow:gmnCompacts, or it carries no attributing gmeow:vantage. A compaction is a reified NEW claim about older claims — a gmeow:StandpointClaim — so it is auditable exactly when every compacted source is reachable through its gmeow:gmnCompacts edges and the standpoint holding the condensation is named; a compaction with a partial source list or no vantage is a hidden loss wearing a claim's clothes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnCompactionOverclaim
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Compaction Overclaim"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:GmnCompaction's correspondence claims a preservation stronger than the compaction discipline licenses: logic:mnemomorphic true, logic:ExactPreservation, or logic:SoundUnderApproximation — anything stronger than logic:ValidationOnly. Compaction is lossy by nature and get-leg-only (the GMN-1 → GMN-2 crossing gmeow:gmnCorrGmnToCompacted is a validation-only bridge view with no round-trip obligation), so a compaction claiming exactness, soundness, or recoverability has asserted a witness the crossing's own law-spine denies."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnUncoveredTerm
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Uncovered Term"@x-gmeow-english ;
    skos:definition "The failure raised when a GMN document uses an alias that the pinned dictionary version does not mint, or names a term the codebook's alias table does not cover. Alias resolution is version-pinned — an alias is meaningless without the gmeow:gmnDictionaryVersion that minted it — so an uncovered term is undecodable, never guessable. Its enforcing validator is the GMN parser/writer: coverage is a join between document tokens and the alias table, state that lives in the codebook rather than in the graph a SHACL shape can see."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnGraphOutOfDomain
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Graph Out Of Domain"@x-gmeow-english ;
    skos:definition "The failure raised when a quad carries a named graph, which is outside the default-graph GMN-0 normal-form domain. GMN-0 is a default-graph quad set by charter, and the GMN-1 record shape has no graph slot, so a named-graph quad is genuinely out of domain — an honest domain boundary, not a lang:GmnUncoveredTerm residual: no larger dictionary or richer term grammar could bring it in-domain, because there is no graph coordinate to carry it. Distinct from lang:GmnUncoveredTerm (a document token the pinned dictionary cannot resolve, which a wider alias table could cover). Its enforcing validator is the GMN parser/writer, which refuses a named-graph quad at emit time rather than silently dropping the graph."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnNonCanonicalOrder
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Non-Canonical Order"@x-gmeow-english ;
    skos:definition "The failure raised when a GMN document's records are not in the canonical order the writer emits — the content-sorted order inherited from the GMN-0 narrow-waist normal form. Canonical order is what makes two conforming serializations of one model byte-comparable; a permuted document decodes to the same model but forfeits the digest discipline. Its enforcing validator is the GMN parser/writer, which checks the emitted sequence against the sort the normal form defines."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnMalformedNumber
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Malformed Number"@x-gmeow-english ;
    skos:definition "The failure raised when a numeric token in a GMN document does not conform to the grammar's number production — a confidence outside its two-fractional-digit rounding, a magnitude written in a non-canonical form, or a numeral the LL(1) grammar cannot accept. Numbers in GMN are canonical-form data, not free text, because the token channel's compression depends on one spelling per value. Its enforcing validator is the GMN parser/writer, whose table-driven number production is the rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnUndeclaredDialectVersion
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Undeclared Dialect Version"@x-gmeow-english ;
    skos:definition "The failure raised when a GMN document reaches a reader without its dialect coordinates — a payload whose envelope header does not pin the gmeow:gmnSchemaVersion, gmeow:gmnDictionaryVersion, and gmeow:gmnGlyphTableVersion it was serialized under. An undeclared version is not defaultable: aliases and glyphs are meaningful only against their pinned tables, so the reader must refuse rather than guess. Its enforcing validator is the GMN parser/writer, which reads the header before any record; the graph-side counterpart on an envelope individual is lang:GmnMissingEnvelopeField."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnCodebookDigestMismatch
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Codebook Digest Mismatch"@x-gmeow-english ;
    skos:definition "The failure raised when an envelope's declared gmeow:gmnCodebookDigest does not equal the codebook's recomputed Merkle-root digest: the encoding claims a codebook identity the actual codebook does not have, so decode would run against the wrong frame — a different alias table, glyph table, or sigil discipline than the one the document was written under. The declared digest is a content address, not a hint, so a reader must refuse rather than decode against a codebook the digest does not name. Its enforcing validator is the native GMN gate that recomputes the codebook's Merkle root over its per-part leaves and compares it to the declared value — a computed cross-node check whose state lives in the codebook and the recomputation, not in the graph a SHACL shape can see."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnNonDecodableGrammar
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Non-Decodable Grammar"@x-gmeow-english ;
    skos:definition "The failure raised when the GMN grammar's declared determinism contract does not hold — a grammar carrying gmeow:gmnDeterminismClass \"LL(1)\" whose rules are not deterministically decidable with one-token lookahead, so a reader cannot know from the next token which production applies and the stream is not prefix-decodable. The determinism class is a declared contract, never taken on faith: its enforcing validator is the GMN parser/writer, whose parse-table construction over the grammar's rules is the machine check the literal must survive."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# The linguistic symbology plane of the GMN dialect                           #
#                                                                             #
# The lang: plane of the shared GMN glyph inventory: the IPA phonological     #
# notation, the Leipzig Glossing Rules alias plane, and the GMN operator      #
# glyphs the linguistic surface renders. Every glyph is authored as the       #
# canonical lang:Denotation fact (the gmeow:gmnGlyph / gmeow:gmnCodepoints    #
# projections flatten it for the writer), carries its codepoint-explicit      #
# spelling on the lang:Grapheme, and carries its MEASURED token cost through  #
# gmeow:gmnGlyphTokenCost. A conventional symbol earns a glyph slot when it   #
# costs no more than its meaningful fallback; a dearer symbol stays a key.    #
# Symbols measured out of the glyph table (⟦·⟧ denotation brackets, the ⇝     #
# translation leg) are                                                        #
# authored as named keys with no grapheme, their disposition read off the     #
# crate-side token-cost measurement, never pre-committed.                     #
# =========================================================================== #

# --- Plane + coverage vocabulary -------------------------------------------- #

lang:GmnImportedPlane
    a owl:Class ;
    rdfs:subClassOf lang:SignSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Imported Plane"@x-gmeow-english ;
    skos:definition "An external notation or gloss standard imported verbatim into the GMN symbology inventory — the IPA chart, the Leipzig Glossing Rules — as a first-class lang:SignSystem the codebook references. An imported plane is imported by reference, never re-minted, so it must carry both its citation (gmeow:cites, typed by a gmeow:CitationAct) and its version (dcterms:hasVersion): a plane without a citation or a version is an unattributed or unpinned import, and the alias table it stands for is meaningless without the edition it was drawn from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnUndispositionedTerm
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Undispositioned Term"@x-gmeow-english ;
    skos:definition "The graph-side coverage failure: a lang: term the GMN linguistic surface emits — a morphological lang:FeatureValue of the feature inventory — that carries no disposition in the symbology plane, no lang:Denotation binding it to a glyph, a named key, or an imported alias. Coverage is total by rule: every emitted term is glyphed, alias-planed, or named-key-ruled, so an undispositioned term is a silent gap in the plane. It is distinct from lang:GmnUncoveredTerm, which is the writer-tier failure of a document token the pinned dictionary cannot resolve at emit time; this one is authoring-time completeness a SHACL shape sees in the graph."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnUnattributedPlane
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Unattributed Plane"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:GmnImportedPlane omits its citation or its version: an imported notation or gloss standard is imported verbatim by reference, so it is meaningless without both the gmeow:cites edge naming the source work and the dcterms:hasVersion literal pinning the edition the aliases were drawn from. An unattributed or unpinned plane is an import that cannot be audited or resolved."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GmnUncostedScriptGlyph
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Uncosted Script Glyph"@x-gmeow-english ;
    skos:definition "The graph-side coverage failure of the glyph plane: a lang:Grapheme admitted to the GMN script (lang:inScript gmeow:gmnScript) — an IPA phonological grapheme, the `*` operator glyph — that carries no gmeow:gmnGlyphTokenCost, the measured per-glyph token-cost feed the glyph-versus-named-key disposition is read off. Cost coverage over the shared inventory is total by rule: a symbol earns a glyph slot only when its measured cost warrants one, so a script glyph with no cost feed is a silent gap in the disposition plane. It is the glyph-plane sibling of lang:GmnUndispositionedTerm, which is the feature-value-plane coverage failure; together they close the plane against silent gaps."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Mentation <-> lang binding gate. This is NOT one of the                    #
# thirteen GMN dialect hard rules enumerated above — LANG-CONFORMANCE.md's rule #
# count is unchanged by this class. It is a separate cross-slice competency   #
# check proving gmeow:processExport (mentation, core tier) binds to           #
# gmeow:GmnSecurityRing (lang, this slice) through the gmeow:wasGeneratedBy   #
# hook already in the envelope's eight-field contract, so mentation names no  #
# lang term and gains no gmeow:sliceDependsOn edge on lang — the reference    #
# direction stays lang -> mentation (this slice's manifest declares the       #
# dependency; docs/GROUNDING.md's tier rule permits a grounding slice to      #
# depend on a non-grounding slice for a non-grounding concept, and lang       #
# already depends on other core-tier slices such as provenance and events).   #
# =========================================================================== #

lang:GmnUnringedExportCrossing
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN Unringed Export Crossing"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:GmnEnvelope whose gmeow:wasGeneratedBy names an activity carrying gmeow:mentalProcessType gmeow:processExport (mentation slice) declares no gmeow:gmnSecurityRing. gmeow:processExport is the externalization/communication episode of an information-flow-controlled agent's mental timeline — the emit member of mentation's train/audit/export triple — and its disclosure semantics are governed BY REFERENCE (Principle 5) by the boundary ring the envelope it generates was admitted under. An export activity that generated an envelope with no ring crossed a serialization boundary with no admission class checked, exactly the disclosure gap the security-ring model exists to close."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- The per-glyph token-cost feed ------------------------------------------ #

gmeow:gmnGlyphTokenCost
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "gmn glyph token cost"@x-gmeow-english ;
    skos:definition "The measured token cost of a GMN glyph over the LLM token channel: relates a glyph-bearing GMN sign (a lang:Grapheme) to the math:Quantity counting the BPE tokens its rendering encodes to under the pinned codebook vocabulary. This is the per-glyph feed the machine-compression sibling folds into the token-cost matrix, and it is a MEASURED value — the crate-side glyph token-cost primitive is its source of truth, and an authored value that diverges from the measurement is a defect the cross-check catches. Domain a glyph-bearing sign, range math:Quantity (stated in prose)."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid hand-tuning the value away from the measured cost — the crate-side primitive is authoritative and the cross-check enforces equality — and avoid reading it as a rate declaration; the declared code rate is gmeow:gmnDeclaredRate, this is a per-glyph measurement."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Attach one gmeow:gmnGlyphTokenCost edge per authored glyph, pointing at a dimensionless math:Quantity whose math:quantityValue is the token count the crate-side primitive measures for the glyph's rendering."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to read a glyph's measured token cost when deriving the token-cost matrix or the glyph-versus-named-key disposition."@x-gmeow-english .

gmeow:gmnTokenCostOne
    a math:Quantity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "one token"@x-gmeow-english ;
    skos:definition "A measured token cost of one: the dimensionless math:Quantity carried by every GMN glyph the pinned codebook vocabulary encodes to a single token. A single-token glyph is exactly a glyph that earns a slot in the shared inventory rather than staying a named key."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    math:hasDimension math:dimensionless ;
    math:quantityValue 1 .

gmeow:gmnTokenCostTwo
    a math:Quantity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "two tokens"@x-gmeow-english ;
    skos:definition "A measured token cost of two: the dimensionless math:Quantity carried by a GMN glyph the pinned codebook vocabulary fragments into two tokens rather than one. A two-token glyph still earns a slot in the shared inventory when no cheaper rendering of its distinction exists — the IPA primary-stress mark is the worked case — but its measured cost is recorded honestly as two, not flattened to the one-token band."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    math:hasDimension math:dimensionless ;
    math:quantityValue 2 .

gmeow:gmnTokenCostThree
    a math:Quantity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "three tokens"@x-gmeow-english ;
    skos:definition "A measured token cost of three: the dimensionless math:Quantity carried by the established description-logic ⊑ sign under the pinned cl100k_base vocabulary. The explicit ASCII fallback is_subclass_of is no cheaper, so the conventional glyph is admitted without a token penalty rather than being misreported as a one-token symbol."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    math:hasDimension math:dimensionless ;
    math:quantityValue 3 .

# --- Shared denotation context ---------------------------------------------- #

gmeow:gmnLangGlyphContext
    a owl:NamedIndividual , gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the GMN linguistic glyph-table context"@x-gmeow-english ;
    skos:definition "The context object the linguistic-plane glyph and alias denotations name through lang:denotationContext: the GMN glyph-table under which the lang: plane's meaning assignments hold. A denotation is never context-free; this is the shared context of the linguistic symbology plane."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnMathGlyphContext
    a owl:NamedIndividual , gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the GMN mathematical glyph-table context"@x-gmeow-english ;
    skos:definition "The context under which the GMN math-plane forms denote math: constants and operations. It pins those readings to @μ records so familiar notation never escapes into an unscoped global alias."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnLogicGlyphContext
    a owl:NamedIndividual , gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the GMN logical glyph-table context"@x-gmeow-english ;
    skos:definition "The context under which the GMN logic-plane forms denote logic: formula constructors and relations. It pins those readings to @ℒ records rather than treating logical typography as a global RDF alias."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnUnicodeMathWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unicode mathematical and Greek symbol repertoire"@x-gmeow-english ;
    skos:definition "The Unicode Standard repertoire and character semantics for the mathematical operators and Greek letters used by the GMN grounding glyph inventory, including ¬, ⊑, ×, π, and γ."@x-gmeow-english ;
    gmeow:title "The Unicode Standard — Mathematical Operators and Greek and Coptic"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnOpenMathWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "OpenMath content dictionaries"@x-gmeow-english ;
    skos:definition "The OpenMath content-dictionary corpus cited for the denotations of arithmetic operations and named mathematical constants in the GMN math plane."@x-gmeow-english ;
    gmeow:title "OpenMath Content Dictionaries"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnInformationTheoryWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "information-theory notation reference"@x-gmeow-english ;
    skos:definition "The standard information-theory reference cited for the conventional notation of entropy H(P), mutual information I(X;Y), and the Kullback–Leibler divergence D(P‖Q), whose GMN symbol dispositions keep them as framed named keys rather than flattened single glyphs."@x-gmeow-english ;
    gmeow:title "Cover & Thomas — Elements of Information Theory"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCommonLogicWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Common Logic standard"@x-gmeow-english ;
    skos:definition "The ISO Common Logic standard cited for the strong-negation meaning represented by the GMN logic-plane ¬ sign; Unicode supplies the character identity while Common Logic supplies the logical reading."@x-gmeow-english ;
    gmeow:title "ISO/IEC 24707 Common Logic"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnDescriptionLogicNotationWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "description-logic subsumption notation"@x-gmeow-english ;
    skos:definition "The established description-logic notation practice cited for the square-image-of-or-equal-to sign ⊑ as class subsumption. GMN binds that sign to the canonical logic:subClassOf relation; the grounding correspondence from logic:subClassOf to rdfs:subClassOf owns the downstream RDFS spelling, so the glyph never makes an external projection term the semantic source."@x-gmeow-english ;
    gmeow:title "The Description Logic Handbook — class subsumption notation"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnFormalSemanticsNotationWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "formal-semantics notation conventions"@x-gmeow-english ;
    skos:definition "The conventional denotation-bracket and translation-arrow repertoire cited when comparing compact GMN named keys with their familiar display notation."@x-gmeow-english ;
    gmeow:title "Formal semantics notation conventions"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnLinguisticNotationWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "linguistic acceptability notation conventions"@x-gmeow-english ;
    skos:definition "The linguistic convention cited for prefixing an unacceptable or ungrammatical form with an asterisk, kept distinct from mathematical multiplication by the @lambda sigil scope."@x-gmeow-english ;
    gmeow:title "Linguistic acceptability notation conventions"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# --- Executable grounding-plane glyph inventory --------------------------- #
# Every adopted sign is a scoped Grapheme -> Form -> Denotation -> target chain.
# GmnGlyphRegistry reads only this graph join; no symbol-to-term table is hard-coded.

gmeow:gmnGlyphLogicNot
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN logical-not glyph"@x-gmeow-english ;
    skos:definition "The NFC ¬ grapheme (U+00AC) in the @ℒ scope, adopted as the executable GMN sign for logic:not after the pinned BPE measured it at one token."@x-gmeow-english ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+00AC" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostOne ;
    gmeow:gmnSigilScope gmeow:gmnSigilLogic ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnFormLogicNot
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the GMN logical-not operator"@x-gmeow-english ;
    skos:definition "The prefix unary GMN form rendered by ¬ and denoting logic:not in the logic glyph context."@x-gmeow-english ;
    lang:inSignSystem gmeow:gmnModelNotation ;
    gmeow:gmnFixity gmeow:gmnFixityPrefix ;
    gmeow:gmnPrecedence 90 ;
    gmeow:gmnArity 1 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnDenLogicNot
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of GMN logical not"@x-gmeow-english ;
    skos:definition "The executable scoped meaning assignment from the GMN ¬ form to logic:not."@x-gmeow-english ;
    lang:denotedForm gmeow:gmnFormLogicNot ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget logic:not ;
    lang:denotationContext gmeow:gmnLogicGlyphContext ;
    gmeow:gmnDenotationGrapheme gmeow:gmnGlyphLogicNot ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateLogicNot
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: logic:not as ¬"@x-gmeow-english ;
    skos:definition "The audited adoption record for rendering strong formula negation logic:not as ¬ in @ℒ records."@x-gmeow-english ;
    gmeow:gmnCandidateTarget logic:not ;
    gmeow:gmnCandidateGlyph "¬" ;
    gmeow:gmnAsciiFallback "not" ;
    gmeow:gmnSpokenLabel "logical not" ;
    gmeow:gmnArity 1 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionAdoptedGlyph ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisTokenCost ;
    gmeow:gmnDispositionRationale "The conventional strong-negation sign ¬ and the ASCII key not each cost one pinned cl100k_base token; ¬ is adopted because it preserves the established logical reading without a token penalty, scoped to @ℒ." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenLogicNot ;
    gmeow:cites gmeow:gmnCommonLogicWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnGlyphLogicSubClassOf
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN class-subsumption glyph"@x-gmeow-english ;
    skos:definition "The NFC ⊑ grapheme (U+2291) in the @ℒ scope, adopted as the executable GMN sign for the canonical class-subsumption relation logic:subClassOf. The RDFS rdfs:subClassOf spelling remains a generated grounding target rather than the glyph's denotation owner."@x-gmeow-english ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+2291" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostThree ;
    gmeow:gmnSigilScope gmeow:gmnSigilLogic ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnFormLogicSubClassOf
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the GMN class-subsumption operator"@x-gmeow-english ;
    skos:definition "The binary infix GMN form rendered by ⊑ and denoting canonical logic:subClassOf in the logical glyph context."@x-gmeow-english ;
    lang:inSignSystem gmeow:gmnModelNotation ;
    gmeow:gmnFixity gmeow:gmnFixityInfix ;
    gmeow:gmnPrecedence 20 ;
    gmeow:gmnArity 2 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnDenLogicSubClassOf
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of GMN class subsumption"@x-gmeow-english ;
    skos:definition "The executable scoped meaning assignment from the GMN ⊑ form to canonical logic:subClassOf. Its grounding correspondence lowers the relation to rdfs:subClassOf without reversing semantic ownership."@x-gmeow-english ;
    lang:denotedForm gmeow:gmnFormLogicSubClassOf ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget logic:subClassOf ;
    lang:denotationContext gmeow:gmnLogicGlyphContext ;
    gmeow:gmnDenotationGrapheme gmeow:gmnGlyphLogicSubClassOf ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateLogicSubClassOf
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: logic:subClassOf as ⊑"@x-gmeow-english ;
    skos:definition "The audited adoption record for rendering canonical class subsumption logic:subClassOf as ⊑ in @ℒ records."@x-gmeow-english ;
    gmeow:gmnCandidateTarget logic:subClassOf ;
    gmeow:gmnCandidateGlyph "⊑" ;
    gmeow:gmnAsciiFallback "is_subclass_of" ;
    gmeow:gmnSpokenLabel "is a subclass of" ;
    gmeow:gmnArity 2 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionAdoptedGlyph ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisTokenCost ;
    gmeow:gmnDispositionRationale "The established description-logic ⊑ sign costs no more than the explicit ASCII fallback is_subclass_of under the pinned cl100k_base vocabulary; ⊑ is adopted without a token penalty, with @ℒ scope and binary infix metadata preserving its class-subsumption reading." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenLogicSubClassOf ;
    gmeow:cites gmeow:gmnDescriptionLogicNotationWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnGlyphMathPi
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
