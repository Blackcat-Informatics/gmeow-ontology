#
# Well-formed: a binding expression with a bound variable declaration and an
# occurrence resolving to it, over an indexed body slot. Conforms to
# math:ArgumentSlotShape and math:VariableOccurrenceShape. Bound by ex:ecBindingScoped.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:sumBinder a math:BindingExpression ;
    math:operator math:summationBinder ;
    math:boundVariable ex:iDecl ;
    math:bindsOccurrence ex:iOccurrence ;
    math:argumentSlot ex:sumBinderSlot0 .

ex:sumBinderSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:summand .

ex:summand a math:MathematicalExpression .
ex:iDecl a math:VariableDeclaration .
ex:iOccurrence a math:VariableOccurrence ;
    math:declaredVariable ex:iDecl ;
    math:occursInScope ex:sumBinder .
