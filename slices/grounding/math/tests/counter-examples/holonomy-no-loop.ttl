#
# Counter-example for the math:Holonomy frame (issue #1527, Commit E): a math:Holonomy
# naming its math:holonomyOf connection but omitting its math:holonomyLoop — holonomy
# without a closed loop measures nothing. The min-1 qualified restriction on
# math:holonomyLoop derives a sh:qualifiedMinCount property shape, so validation MUST emit
# shacl.QualifiedMinCountConstraintComponent and NO other finding (math:IncompleteHolonomy).
# ISOLATION: the math:holonomyOf arm is satisfied by a well-formed math:Connection (naming
# its math:connectionOn so math:IncompleteConnection stays silent), so only the
# math:holonomyLoop arm fires.
# Back-reference: math:IncompleteHolonomy (slices/grounding/math/module.ttl).
# Bound by tests/example-conformance.ttl (ex:ecHolonomyNoLoop).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:holonomy a math:Holonomy ;
    math:holonomyOf ex:connection .        # names the connection but NO math:holonomyLoop

ex:connection a math:Connection ;
    math:connectionOn ex:sheaf .
ex:sheaf a math:CellularSheaf ;
    math:sheafBaseComplex ex:base ;
    math:hasStalk ex:stalk ;
    math:restrictionMap ex:restriction .
ex:base a math:CellComplex .
ex:stalk a math:SheafStalk ; math:stalkOverCell ex:cell .
ex:cell a math:MathematicalObject .
ex:restriction a math:SheafRestrictionMap ; math:sourceObject ex:stalk ; math:targetObject ex:stalk .
