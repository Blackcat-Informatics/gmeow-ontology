@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# The agent-runtime PROFILE (profile tier). A PURE SELECTION that mints nothing
# (Principle 16): no module.ttl, no minted terms — it composes existing slices
# into one dependency-closed sub-ontology for the AI-agent / MCP-developer
# audience. Its selection rides gmeow:sliceDependsOn; the profiles stage emits the
# dependency closure as generated/profiles/agent-runtime.ttl (a dereferenceable,
# citable import target). The design's "memory" and "claims" constituents are not
# separate slices — they are provided transitively through core/inhabitation (the
# durable subject, the TransferManifest / MemoryView memory topology) and its
# epistemics / standpoint dependencies (claims-as-observations); core/agentic
# adds the tool-call / trajectory layer and core/awareness the serving modes.

<https://blackcatinformatics.ca/gmeow/slices/agent-runtime>
    a gmeow:Slice ;
    rdfs:label "agent-runtime"@x-gmeow-english ;
    skos:definition "The agent-runtime profile of the GMEOW ontology (profile tier): a pure selection for the AI-agent / MCP-developer audience — a durable subject inhabiting a served model, with its runtime provenance, tool use, serving modes, and claims/memory, loaded as one coherent, dependency-closed sub-ontology. Mints NOTHING (Principle 16); the composition rides the open gmeow:configurationFacet at the instance level. Selection: core/inhabitation + extensions/model-serving + core/agentic + core/awareness and their sliceDependsOn closure (which supplies the epistemics/standpoint claims layer and the memory-transfer topology)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agent-runtime> ;
    dcterms:title "GMEOW Agent-Runtime Profile"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierProfile ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/inhabitation> ,
        <https://blackcatinformatics.ca/gmeow/slices/model-serving> ,
        <https://blackcatinformatics.ca/gmeow/slices/agentic> ,
        <https://blackcatinformatics.ca/gmeow/slices/awareness> ;
    gmeow:sliceConsumer "The AI-agent / MCP-developer audience (Principle 15): the GTS ai-package and the MCP store / recall / revise memory triad — a durable subject inhabiting a served model, tracing each output to the exact artifact·deployment·execution·session·invocation that produced it, with its tool calls, serving modes, and contestable claims, loaded as one dependency-closed unit."@x-gmeow-english .
