@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/agreements>
    a owl:Ontology ;
    rdfs:label "GMEOW Agreements Module"@x-gmeow-english ;
    skos:definition "The GMEOW Agreements Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/agreements> ;
    rdfs:comment "Legal agreements and contracts, modeled as relators binding their parties."@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

gmeow:Agreement
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Agreement"@x-gmeow-english ;
    skos:definition "A mutual understanding between two or more agents that creates obligations or rights, reified as a relator connecting its parties."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Contract
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Agreement ;
    rdfs:label "Contract"@x-gmeow-english ;
    skos:definition "A legally enforceable agreement."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:AgreementName
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Appellation ;
    rdfs:label "Agreement Name"@x-gmeow-english ;
    skos:definition "An appellation borne by an agreement — a formal title, short name, or multilingual version of a contract or legal instrument. Carries its own gmeow:nameLanguage and gmeow:nameScript so co-equal multilingual names are separate first-class objects."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasParty
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agreement ;
    rdfs:range gmeow:Agent ;
    rdfs:label "has party"@x-gmeow-english ;
    skos:definition "Relates an agreement to an agent that is bound by it."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:foundedOn
    a owl:ObjectProperty ;
    rdfs:domain gufo:Relator ;
    rdfs:range gmeow:Agreement ;
    rdfs:label "founded on"@x-gmeow-english ;
    skos:definition "The agreement or contract that grounds this relator — in UFO terms, the set of commitments on which the relator is founded. Reusable across any relator (Membership, KinRelationship, etc.)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
