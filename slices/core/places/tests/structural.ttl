PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasTrajectorySample a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasTrajectorySample MUST NOT be owl:FunctionalProperty -- a trajectory may have many samples." .

