msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationMonotonicityLaw|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query iteration monotonicity law"
msgstr "Loi de monotonie d’itération de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationMonotonicityLaw|http://www.w3.org/2004/02/skos/core#definition"
msgid "Candidate membership never shrinks between consecutive completed states."
msgstr "L’appartenance des candidats ne diminue jamais entre états achevés consécutifs."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationMonotonicityLaw|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query iteration monotonicity law with explicit source bindings."
msgstr "Utiliser pour décrire loi de monotonie d’itération de requête avec des liens source explicites."

