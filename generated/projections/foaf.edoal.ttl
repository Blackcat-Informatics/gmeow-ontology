@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/foaf>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Place ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri wgs84:SpatialThing ;
        ] ;
        align:relation "<=" ;
        rdfs:label "Place with coordinates → wgs84:SpatialThing (lat/long, no WKT)"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:depicts ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri foaf:depiction ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "depicting MediaObject → foaf:depiction (entity → image)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:fullName ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri foaf:name ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnSelectDisplayName ;
            ] ;
            rdfs:label "displayable fullName → foaf:name"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasAuthor ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:maker ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "hasAuthor → foaf:maker (+ foaf:made inverse)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasContactPoint ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:mbox ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "contact-point email address → foaf:mbox"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasGenderIdentity ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:gender ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.6"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnSelectDisplayableGender ;
            ] ;
            rdfs:label "displayable GenderIdentity value → foaf:gender (lossy; suppressed labels dropped)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasLogo ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:logo ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "hasLogo → foaf:logo"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasMet ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:knows ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "kinship/hasMet between persons → foaf:knows"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasName ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:nick ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnNicknameName ;
            ] ;
            rdfs:label "nickname-purpose PersonName → foaf:nick"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasNetworkAddress ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:page ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "NetworkAddress (URL type) → foaf:page"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasRole ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:title ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "membership role label → foaf:title (job/honorific title)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasWebPage ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:homepage ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnWebPageToUrl ;
            ] ;
            rdfs:label "hasWebPage → foaf:homepage (the WebPage IRI)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:locatedAt ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri foaf:based_near ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.7"^^xsd:double ;
            rdfs:label "locatedAt a Place → foaf:based_near"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:partText ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri foaf:familyName ;
            ] ;
            align:relation "<=" ;
            rdfs:label "family-name part → foaf:familyName"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:partText ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri foaf:givenName ;
            ] ;
            align:relation "<=" ;
            rdfs:label "given-name part → foaf:givenName"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:telephone ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri foaf:phone ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "telephone → foaf:phone (tel: resource)"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "foaf" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → foaf (EDOAL)"@en .
