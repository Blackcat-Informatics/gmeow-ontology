msgctxt "https://blackcatinformatics.ca/gmeow/attemptSummary|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attempt summary"
msgstr "résumé de tentative"

msgctxt "https://blackcatinformatics.ca/gmeow/attemptSummary|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source's verbatim summary on an attempt-finish event. It reports the attempt without entailing goal satisfaction and does not specialize the Entity-domain description property."
msgstr "Résumé textuel fourni par la source sur un événement de fin de tentative. Il relate la tentative sans entraîner la satisfaction du but ni spécialiser description dont le domaine est Entity."

msgctxt "https://blackcatinformatics.ca/gmeow/attemptSummary|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

