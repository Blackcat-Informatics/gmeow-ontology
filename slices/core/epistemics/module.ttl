@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:AdequacyAssessment
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Adequacy Assessment"@x-gmeow-english ;
    logic:mediates gmeow:adequacyUnderStandard ,
        gmeow:meetsThreshold ;
    rdfs:subClassOf logic:Relator ;
    skos:definition "A reified, solver-set judgement that a justification's support MEETS (or fails) the threshold of a named epistemic standard — carrying the standard (gmeow:adequacyUnderStandard -> gmeow:EpistemicStandard) and the verdict (gmeow:meetsThreshold -> gmeow:AdequacyVerdict). Adequacy is the fourth of the five factored justification components (available-evidence, basing, support-under-a-standard, adequacy, defeat): whether the support meets the standard's bar. COMPUTED, never asserted (Principle 12); the same basis may be adequate under one standard and inadequate under a stricter one, so several assessments coexist (Principle 9)."@x-gmeow-english ;
    skos:scopeNote "Reached from a gmeow:JustificationSubject via gmeow:adequateUnder. Formalises the 'adequacy — meets the standard's threshold' component of design/LOGIC-FOUNDATION.md (Argumentation and epistemic standards), by prose reference (Principle 5)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AdequacyVerdict
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Adequacy Verdict"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The solver-set outcome of a gmeow:AdequacyAssessment — a value vocabulary (individuals, never subclasses): gmeow:adequacyMet (the support meets the standard's threshold), gmeow:adequacyUnmet (it falls short), gmeow:adequacyUndetermined (the solver cannot yet decide). A solver value (Principle 12); there is no asserted 'adequate' bit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Attestation
    rdfs:subClassOf gmeow:JustificationGround .

gmeow:ClaimEvaluation
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Claim Evaluation"@x-gmeow-english ;
    rdfs:subClassOf gmeow:ClaimToken ;
    skos:definition "An evaluative claim about a claim — a judgment of a claim token against a standard (warranted / unwarranted, sincere / insincere, sound / unsound), itself a claim token (the foundation: an evaluation is a separate claim with its own standpoint and provenance). Reuses the whole claim apparatus recursively: it gmeow:evaluates the target token, is held according to a frame via inherited gmeow:accordingTo (its CONTEXT — a gmeow:Standpoint, the materialised typed context truth is relative to), and carries its verdict as the gmeow:Proposition it gmeow:expresses under a modality. One token may be evaluated differently under different contexts, and those evaluations coexist (Principle 9); the reasoner never sets a verdict (Principle 12)."@x-gmeow-english ;
    skos:example "ex:eval1 a gmeow:ClaimEvaluation ; gmeow:evaluates ex:tok1 ; gmeow:accordingTo ex:courtFrame ; gmeow:expresses ex:tok1IsWarranted ."@x-gmeow-english ;
    skos:scopeNote "The formal four-valued (Belnap / FDE) TRUTH verdict of a reasoner is the logic:ReasoningResult (logic:resultInformation) — a distinct standard, referenced not duplicated. The lightweight defeat flag on a claim is gmeow:hasDefeatStatus → gmeow:JustificationStatus; gmeow:ClaimEvaluation is the heavy, context-indexed, reifiable form whose own identity, frame, and provenance are first-class. Context is gmeow:Standpoint (the materialised typed context); a single undifferentiated world would be a category error (the typed-context-algebra doctrine)."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a bare defeat flag (use gmeow:hasDefeatStatus directly on the claim) and for the reasoner's truth verdict (that is logic:ReasoningResult); avoid letting one evaluation win over the rest — competing evaluations under different contexts coexist (Principle 9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one ClaimEvaluation per (token, context) assessment; point gmeow:evaluates at the target gmeow:ClaimToken, gmeow:accordingTo at the gmeow:Standpoint context, and gmeow:expresses at the verdict proposition; carry the qualitative verdict as its claim modality. Supersede by minting a new evaluation and suppressing the old with gmeow:displayable false (Principle 10)."@x-gmeow-english ;
    gmeow:useWhen "Use when the assessment of a claim token under a particular context / standard is itself a fact of interest — when the context, the verdict, and the evaluation's own identity and provenance must be queryable or revisable, beyond a bare gmeow:hasDefeatStatus flag."@x-gmeow-english .

gmeow:ClaimToken
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Claim Token"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Activity ;
    skos:definition "A single datable assertion act — one source, on one occasion, putting one or more propositions forward under an assertoric force. A perdurant WITH PROVENANCE (a gmeow:Activity): performed by an agent via gmeow:wasAssociatedWith, held according to a frame via gmeow:accordingTo, datable on the event. The claim TOKEN is distinct from the propositional content it expresses (gmeow:expresses → gmeow:Proposition), from the attitude held toward it (gmeow:heldByAttitude → gmeow:DoxasticState or teleology gmeow:IntentionalMode), and from any evaluation of it (gmeow:ClaimEvaluation). One proposition may be expressed by many coexisting tokens, and one token may express several propositions (Principle 9); a token is retractable by suppression (gmeow:displayable false, Principle 10) without erasing the content it expressed."@x-gmeow-english ;
    skos:example "ex:tok1 a gmeow:ClaimToken ; gmeow:wasAssociatedWith ex:authorityA ; gmeow:accordingTo ex:standpointA ; gmeow:expresses ex:earthIsRound ."@x-gmeow-english ;
    skos:scopeNote "The legacy gmeow:StandpointClaim (a gmeow:Observation relator) is the GENERATED projected union view of a claim token — the convenience surface the foundation prescribes (a projected union view over the four constructs), never the canonical record. Author claims as gmeow:ClaimToken; the Observation/StandpointClaim surface is materialised from them so generic 'all observations about X' queries keep working."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a ClaimToken for the propositional content itself (that is gmeow:Proposition, which asserts nothing by itself) or for the held attitude (gmeow:DoxasticState); a token is the datable act of putting a proposition forward, not the content and not the belief."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one ClaimToken per assertion act; link its content with gmeow:expresses (one or many propositions), its performing agent with gmeow:wasAssociatedWith, its frame with gmeow:accordingTo; attach the reported attitude with gmeow:heldByAttitude and the producing event via the inverse of gmeow:producesClaim; evaluations reference it via gmeow:evaluates. Retract by suppression (gmeow:displayable false), never deletion (Principle 10)."@x-gmeow-english ;
    gmeow:useWhen "Use as the canonical assertion-act token whenever a proposition is PUT FORWARD by a source on an occasion — so the content, the act, the attitude, and the evaluation stay four distinct identities (the foundational claim separation)."@x-gmeow-english .

gmeow:Defeater
    a logic:Category ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Defeater"@x-gmeow-english ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [
        a owl:Class ;
        owl:unionOf ( gmeow:Argument gmeow:StandpointClaim gmeow:EvidenceSpan ) ;
    ] ;
    skos:definition "The class of things that can DEFEAT a justification — an gmeow:Argument (the inference-slice argumentation node), a gmeow:StandpointClaim (a defeating consideration), or a gmeow:EvidenceSpan (defeating evidence). The structural defeater that gmeow:defeatedBy points at, distinct from the solver-set verdict FLAG gmeow:hasDefeatStatus -> gmeow:JustificationStatus. Introduced as a named superclass so that schema projections can assign a single range to gmeow:defeatedBy instead of losing a blank-node owl:unionOf."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:DoxasticStandpointClaim
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "doxastic standpoint claim"@x-gmeow-english ;
    rdfs:subClassOf gmeow:StandpointClaim ;
    skos:definition "A StandpointClaim that explicitly reports a held DoxasticState — the reified, vantage-indexed claim that an agent is in a particular believing mode toward a proposition. It carries the qualitative claimModality of the belief and links to the underlying DoxasticState via gmeow:claimOfBelief, so the holding can be justified or defeated in this module (Principles 9, 15)."@x-gmeow-english ;
    skos:example "ex:aliceRoundClaim a gmeow:DoxasticStandpointClaim ; gmeow:vantage ex:alice ; gmeow:observedFeature ex:earthIsRound ; gmeow:claimOfBelief ex:aliceBelievesRound ; gmeow:claimModality gmeow:unequivocal ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid when the flat doxastic spine suffices; do not mint both a flat believes statement and a DoxasticStandpointClaim for the same holding without a clear reason (Principle 4)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one DoxasticStandpointClaim per (agent, proposition, belief-modality) tuple; set its vantage to the agent, observedFeature to the proposition, claimModality to the qualitative belief value, and claimOfBelief to the underlying DoxasticState. Justification is factored via gmeow:hasAvailableEvidence / gmeow:basesBeliefOn / gmeow:supportsUnder / gmeow:adequateUnder and defeat via gmeow:defeatedBy / gmeow:hasDefeatStatus in this module."@x-gmeow-english ;
    gmeow:useWhen "Use when a belief report must be a first-class StandpointClaim that can be justified, defeated, or standpoint-indexed independently of the flat gmeow:believes / gmeow:knowsThat spine (Principle 9)."@x-gmeow-english .

gmeow:DoxasticState
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Doxastic State"@x-gmeow-english ;
    rdfs:subClassOf gmeow:JustificationGround ,
        gmeow:JustificationSubject ,
        gmeow:MentalMoment ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:epistemicAgent ;
            owl:someValuesFrom gmeow:Agent ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:doxasticContent ;
            owl:someValuesFrom gmeow:Proposition ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:doxasticClaim ;
            owl:someValuesFrom gmeow:StandpointClaim ;
        ] ;
    skos:definition "An agent's intrinsic believing mode toward a proposition — the reified, first-class mental moment that grounds the flat doxastic spine (gmeow:believes, gmeow:knowsThat). A sibling of cognition:CognitiveState (knowing) and teleology:IntentionalMode (desiring/intending) under kernel:MentalMoment, so an agent's whole endurant mental life is queryable as one family (Principle 15). Inheres in exactly one agent via epistemicAgent and is directed at exactly one Proposition via doxasticContent; its qualitative belief value is carried by a linked StandpointClaim (doxasticClaim → claimModality), and its graded strength by credence [0,1]. Never instantiated directly when the flat spine suffices (Principle 4)."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound a gmeow:DoxasticState ; gmeow:epistemicAgent ex:alice ; gmeow:doxasticContent ex:earthIsRound ; gmeow:doxasticClaim ex:aliceRoundClaim ; gmeow:credence \"0.92\"^^xsd:decimal ."@x-gmeow-english ;
    skos:scopeNote "A DoxasticState grounds the canonical claim tokens that report it via gmeow:groundsClaim (the attitude→token link, inverse of gmeow:heldByAttitude), distinct from gmeow:doxasticClaim which links to the standpoint-slice gmeow:StandpointClaim VIEW. An attitude may ground several tokens or none (a belief never put forward) — the held/projected gap (Principle 9)."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the 80% case where an agent simply believes a proposition — use the flat gmeow:believes / gmeow:knowsThat spine and carry modality on the statement layer; avoid double-typing a belief as both a flat relation and a DoxasticState for the same holding (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one DoxasticState per (agent, proposition, claim-modality) tuple; link it via gmeow:doxasticClaim to a StandpointClaim whose vantage is the agent, observedFeature is the proposition, and claimModality carries the qualitative value; attach credence for graded strength and a DoxasticTenure when belief revision history matters."@x-gmeow-english ;
    gmeow:pairsWith gmeow:DoxasticTenure ;
    gmeow:useWhen "Use when an agent's belief toward a proposition must be first-class — when credence, temporal scope (via DoxasticTenure), standpoint modality, or the mental moment itself needs to be queried or revised (Principle 15)."@x-gmeow-english .

gmeow:DoxasticTenure
    a logic:Situation ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Doxastic Tenure"@x-gmeow-english ;
    rdfs:subClassOf gmeow:TimeScopedRelation ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:tenureOfDoxasticState ;
            owl:someValuesFrom gmeow:DoxasticState ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:duringInterval ;
            owl:someValuesFrom gmeow:TimeInterval ;
        ] ;
    skos:definition "The reified, time-scoped fact that a DoxasticState was held over an interval — the belief-revision history construct. Opened when the belief is adopted; closed (endedAtTime on the duringInterval) and suppressed with displayable false when the belief is revised or retracted. The old DoxasticState is retained as audit, never deleted (Principle 10). Carries its interval via gmeow:duringInterval (temporal module) and links to the scoped DoxasticState via tenureOfDoxasticState."@x-gmeow-english ;
    skos:example "ex:aliceRoundTenure a gmeow:DoxasticTenure ; gmeow:tenureOfDoxasticState ex:aliceBelievesRound ; gmeow:duringInterval ex:2019to2024 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the lightweight case where a bare gmeow:believes statement with validFrom/validUntil suffices; reify on demand (Principle 4)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one DoxasticTenure per DoxasticState adoption interval; point it at the DoxasticState via tenureOfDoxasticState and at a TimeInterval via duringInterval. On revision, close the interval with endedAtTime and set displayable false on the tenure; mint a new DoxasticState and tenure for the revised belief."@x-gmeow-english ;
    gmeow:useWhen "Use when the adoption, revision, or retraction of a belief over time is itself the fact of interest — the heavy form for belief-revision history."@x-gmeow-english .

gmeow:EpistemicContext
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Epistemic Context"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Entity ;
    skos:definition "A doxastic context — the belief-world relative to which an agent's knowledge or belief is held true, the context the typed accessibility relation logic:doxasticallyAccessible ranges over. DISTINCT from gmeow:DoxasticState: the DoxasticState is the intrinsic believing mental moment that inheres in an agent (the believing itself), whereas an EpistemicContext is where the believed propositions hold — the world the belief reaches. One of the distinct typed contexts of the logic context algebra; the logic: accessibility machinery stays central in the logic slice and is referenced here in prose only, with no asserted logic: triples."@x-gmeow-english ;
    skos:example "ex:alicesBeliefWorld a gmeow:EpistemicContext ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for the believing attitude itself — that is gmeow:DoxasticState (the mental moment); the EpistemicContext is the belief-world the attitude reaches. Avoid treating an unindexed claim as holding in any particular EpistemicContext (Principle 9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint an EpistemicContext when an agent's belief-world needs to be a first-class context — the contexts logic:doxasticallyAccessible relates; link the believing gmeow:DoxasticState to its content and let the typed accessibility relation, not the bare logic:accessibleFrom, carry any cross-context reasoning."@x-gmeow-english ;
    gmeow:useWhen "Use to name the doxastic context (belief-world) an agent's knowledge or belief is held true relative to — the typed context of the context algebra that logic:doxasticallyAccessible ranges over, distinct from the gmeow:DoxasticState mental moment."@x-gmeow-english .

gmeow:EpistemicStandard
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Epistemic Standard"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The standard of evidential adequacy a justification is assessed against — a closed-but-open value vocabulary (individuals, never subclasses; the gmeow:StandpointModality idiom): gmeow:standardOrdinary, gmeow:standardScientific, gmeow:standardLegalPreponderance, gmeow:standardLegalClearAndConvincing, gmeow:standardLegalBeyondReasonableDoubt. The named standard parameterises support and adequacy (gmeow:supportsUnder, gmeow:adequateUnder) and the locally-factive gmeow:knowsThatIn: how strongly the evidence must warrant the content differs by standard, so the same basis may be adequate under one and inadequate under another (Principle 9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:EvidenceSpan
    rdfs:subClassOf gmeow:JustificationGround .

gmeow:JustificationGround
    a logic:Category ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Justification Ground"@x-gmeow-english ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [
        a owl:Class ;
        owl:unionOf ( gmeow:EvidenceSpan gmeow:Attestation gmeow:DoxasticState ) ;
    ] ;
    skos:definition "The class of things that can serve as a justification basis — an evidence span, an attestation, or a further doxastic state. Introduced as a named superclass so that schema projections can assign a single range to the justification edges (gmeow:hasAvailableEvidence, gmeow:basesBeliefOn) instead of losing a blank-node owl:unionOf."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:hasAvailableEvidence ex:photoEvidence , ex:expertAttestation , ex:bobBelievesRound ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it as an independent kind of entity; it is a schema-friendly union category whose instances are always EvidenceSpans, Attestations, or DoxasticStates."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let instances be typed as gmeow:EvidenceSpan, gmeow:Attestation, or gmeow:DoxasticState; the explicit subClassOf axioms make them gmeow:JustificationGrounds for downstream schemas."@x-gmeow-english ;
    gmeow:useWhen "Use as the range of gmeow:hasAvailableEvidence and gmeow:basesBeliefOn when projecting the ontology into schema languages that cannot consume a blank-node owl:unionOf."@x-gmeow-english .

gmeow:JustificationStatus
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Justification Status"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "A value vocabulary for justification-defeat states of a doxastic state or standpoint-claim — solver-set flags such as Gettier-case, defeated, undermined, undercut, and rebutted. These are quality values (gufo:QualityValue) attached via gmeow:hasDefeatStatus; the reasoner never infers them (Principle 12)."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:hasDefeatStatus gmeow:justificationStatusGettier ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it as a global truth predicate or letting the reasoner promote/derogate statuses; it is a solver annotation only."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference one of the seeded individuals from a gmeow:hasDefeatStatus link on a gmeow:DoxasticState or gmeow:StandpointClaim; align undermined/undercut/rebutted with the inference slice's typed attack kinds (gmeow:attackUndermine / gmeow:attackUndercut / gmeow:attackRebut)."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary when a solver marks a gmeow:DoxasticState or gmeow:StandpointClaim with a justification-defeat status."@x-gmeow-english .

gmeow:JustificationSubject
    a logic:Category ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Justification Subject"@x-gmeow-english ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [
        a owl:Class ;
        owl:unionOf ( gmeow:DoxasticState gmeow:StandpointClaim ) ;
    ] ;
    skos:definition "The class of things that can carry justification or defeat relations — a doxastic state or a standpoint claim. Introduced as a named superclass so that schema projections (LinkML, TypeScript, GraphQL) can assign a single domain to the justification edges (gmeow:hasAvailableEvidence, gmeow:basesBeliefOn, gmeow:supportsUnder, gmeow:adequateUnder, gmeow:defeatedBy, gmeow:hasDefeatStatus) instead of losing a blank-node owl:unionOf."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound a gmeow:DoxasticState ; gmeow:hasAvailableEvidence ex:photoEvidence . ex:aliceRoundClaim a gmeow:StandpointClaim ; gmeow:hasDefeatStatus gmeow:justificationStatusGettier ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it as an independent kind of entity; it is a schema-friendly union category whose instances are always DoxasticStates or StandpointClaims."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let instances be typed as gmeow:DoxasticState or gmeow:StandpointClaim; the explicit subClassOf axioms make them gmeow:JustificationSubjects for downstream schemas."@x-gmeow-english ;
    gmeow:useWhen "Use as the domain of the justification and defeat edges when projecting the ontology into schema languages that cannot consume a blank-node owl:unionOf."@x-gmeow-english .

gmeow:KnowledgeAttribution
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Knowledge Attribution"@x-gmeow-english ;
    logic:mediates gmeow:attributedKnower ,
        gmeow:attributedProposition ,
        gmeow:attributingAgent ;
    rdfs:subClassOf logic:Relator ;
    skos:definition "A reified, NON-FACTIVE attribution of knowledge — 'X takes themselves (or Y) to know that P' — a claim ABOUT an attitude, never collapsed into the locally-factive gmeow:KnowledgeClaim. Relates an attributing agent (gmeow:attributingAgent), the agent credited with the knowing (gmeow:attributedKnower, which may equal the attributer for self-attribution), and the proposition attributed as known (gmeow:attributedProposition). Carries NO world and NO standard and entails no truth: 'they take themselves to know' is a separate claim, never the factive relation (design/LOGIC-FOUNDATION.md). The flat surface is gmeow:claimsToKnowThat."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:KnowledgeClaim
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Knowledge Claim"@x-gmeow-english ;
    logic:mediates gmeow:knowerAgent ,
        gmeow:knownProposition ,
        gmeow:knownInWorld ;
    rdfs:subClassOf logic:Relator ;
    skos:definition "The reified, LOCALLY-FACTIVE knowing relation — that an agent (gmeow:knowerAgent) knows a proposition (gmeow:knownProposition) IN a belief-world (gmeow:knownInWorld -> gmeow:EpistemicContext) under an epistemic standard (gmeow:underStandard -> gmeow:EpistemicStandard). The promotion target of the flat gmeow:knowsThatIn. Knowledge is locally factive: knowing P in world W entails that P holds IN W, never globally across all worlds — an agent can know contested facts in its own world without the model claiming them everywhere. This is a CLAIM apparatus (a logic:Relator, like gmeow:ClaimToken / inference gmeow:InferenceCommitment), deliberately NOT a kernel:MentalMoment — the believing ATTITUDE remains gmeow:DoxasticState (the mental moment); the KnowledgeClaim reifies the knowing relation, not the attitude."@x-gmeow-english ;
    skos:scopeNote "Local factivity (knowing P in W ⇒ P holds in W) is recorded by PROSE reference (Principle 5), never as an asserted axiom here: there is NO gmeow:isTrue, no factivity OWL axiom, and no asserted logic: triple — the world-indexed rule that makes factivity honest stays central in the logic slice over the typed, world-relative hold predicate (logic:doxasticallyAccessible / the context algebra), never a global truth bit. This keeps the no-truth-bit invariant and the clean DL/EL profile (the standpoint-slice Belnap-correspondence precedent)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Proposition
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Proposition"@x-gmeow-english ;
    rdfs:subClassOf gmeow:SocialObject ;
    skos:definition "A truth-apt content — a described state of affairs that can be held true or false, the object of a doxastic attitude (gmeow:believes, gmeow:knowsThat). Existing by social convention like every description, it is a gmeow:SocialObject. A Proposition asserts nothing by itself: that an agent holds it, and with what modality, is a vantage-indexed claim (Principle 9). It is the doxastic sibling of gmeow:Goal (teleology): a belief and a goal may share the SAME proposition but differ in direction of fit — a belief has mind-to-world fit (it aims to be true to the world), a goal has world-to-mind fit (it aims to make the world true to it)."@x-gmeow-english ;
    skos:example "ex:earthIsRound a gmeow:Proposition ; rdfs:label \"the Earth is round\"@en ."@x-gmeow-english ;
    skos:scopeNote "Direction-of-fit bridge (documentation only — no axiom, no teleology dependency): belief --mind-to-world--> Proposition <--world-to-mind-- Goal. There is deliberately NO gmeow:Goal rdfs:subClassOf gmeow:Proposition; subsumption would erase the direction-of-fit distinction, so the link stays by reference. Proposition is the propositional-content axis of the claim separation: the truth-apt content, distinct from the claim token that expresses it (gmeow:ClaimToken via gmeow:expresses), the attitude held toward it (gmeow:DoxasticState), and any evaluation of it (gmeow:ClaimEvaluation). Its logical form, when needed, is a logic:FormulaFragment in the logic slice, linked by reference — not axiomatised here (the gmeow:vantage / gmeow:accordingTo documented-not-axiomatised precedent)."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting the proposition as a global fact (it asserts nothing by itself — that an agent holds it, and how, is a vantage-indexed claim, never a factive knowledge verdict); avoid subsuming a gmeow:Goal under it, which would erase the direction-of-fit distinction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint the Proposition once, link agents to it through the flat doxastic spine (gmeow:believes, gmeow:doubts, gmeow:accepts, gmeow:knowsThat), and carry how-strongly / from-whose-vantage on gmeow:standpointModality and gmeow:accordingTo of the holding statement; a co-aimed goal references the same proposition rather than subclassing it."@x-gmeow-english ;
    gmeow:useWhen "Use to mint a truth-apt content as its own object — the thing an agent believes, doubts, accepts, or knows-that — so the same proposition can be held by several agents with different modalities, each holding indexed to a vantage (Principle 9)."@x-gmeow-english .

gmeow:StandpointClaim
    rdfs:subClassOf gmeow:JustificationSubject .

gmeow:SupportAssessment
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Support Assessment"@x-gmeow-english ;
    logic:mediates gmeow:supportGround ,
        gmeow:supportUnderStandard ;
    rdfs:subClassOf logic:Relator ;
    skos:definition "A reified, solver-set judgement of HOW STRONGLY a justification ground warrants its content RELATIVE TO a named epistemic standard — carrying the ground (gmeow:supportGround -> gmeow:JustificationGround), the standard (gmeow:supportUnderStandard -> gmeow:EpistemicStandard), and a solver-layer strength (gmeow:supportStrength, xsd:decimal). Support-under-a-standard is the third of the five factored justification components (available-evidence, basing, support-under-a-standard, adequacy, defeat): the same evidence warrants more under a lenient standard than under a strict one. A solver value (Principle 12), and several assessments under different standards coexist (Principle 9)."@x-gmeow-english ;
    skos:scopeNote "Reached from a gmeow:JustificationSubject via gmeow:supportsUnder. Formalises the 'support under a standard' component of design/LOGIC-FOUNDATION.md (Argumentation and epistemic standards), by prose reference (Principle 5)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:accepts
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "accepts"@x-gmeow-english ;
    skos:definition "An agent pragmatically accepts a proposition — takes it on as a working premise for reasoning or action — WITHOUT thereby believing it true. Acceptance is the stance behind 'assume for the sake of argument' and policy defaults; it entails NEITHER belief NOR truth, and is deliberately not a subproperty of gmeow:believes. Range OPEN. Non-functional. Most prior ontologies conflate acceptance with belief; GMEOW keeps them distinct (Principle 1)."@x-gmeow-english ;
    skos:example "ex:alice gmeow:accepts ex:earthIsRound ."@x-gmeow-english ;
    skos:scopeNote "accepts is not a subproperty of believes and entails no truth: a premise accepted for argument is neither believed nor asserted true."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it where the agent genuinely holds the proposition true (use gmeow:believes — acceptance is deliberately not a subproperty of belief and entails neither belief nor truth) and never read it as a factive knowledge verdict; it is the working-premise stance, not a held belief."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the agent at the proposition or reified statement it works from; keep gmeow:accepts strictly separate from gmeow:believes so the projection layer never silently promotes an accepted premise to a believed or known one (Principle 1)."@x-gmeow-english ;
    gmeow:useWhen "Use to record a pragmatic stance — a premise taken on for argument, a policy default, an 'assume for the sake of argument' — that the agent works from WITHOUT thereby believing it true."@x-gmeow-english .

gmeow:adequacyMet
    a gmeow:AdequacyVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "adequacy met"@x-gmeow-english ;
    skos:definition "The support meets the named standard's threshold — the justification is adequate under that standard. A solver-set value (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:adequacyUnderStandard
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AdequacyAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "adequacy under standard"@x-gmeow-english ;
    rdfs:range gmeow:EpistemicStandard ;
    skos:definition "The named epistemic standard a gmeow:AdequacyAssessment judges the support against. Functional: one assessment, one standard."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:adequacyUndetermined
    a gmeow:AdequacyVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "adequacy undetermined"@x-gmeow-english ;
    skos:definition "The solver cannot yet decide whether the support meets the standard's threshold — adequacy is undetermined. A solver-set value (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:adequacyUnmet
    a gmeow:AdequacyVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "adequacy unmet"@x-gmeow-english ;
    skos:definition "The support falls short of the named standard's threshold — the justification is inadequate under that standard. A solver-set value (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:adequateUnder
    a owl:ObjectProperty ;
    rdfs:domain gmeow:JustificationSubject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "adequate under"@x-gmeow-english ;
    rdfs:range gmeow:AdequacyAssessment ;
    skos:definition "Relates a gmeow:JustificationSubject (a gmeow:DoxasticState or gmeow:StandpointClaim) to a reified gmeow:AdequacyAssessment — whether its support meets a named standard's threshold. The ADEQUACY component of the five-way justification split. NOT functional: adequacy may be assessed under several standards, and those assessments coexist (Principle 9). A solver judgement (Principle 12), never a reasoner entailment that the belief counts as knowledge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:attacksClaim
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Argument ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "attacks claim"@x-gmeow-english ;
    rdfs:range gmeow:ClaimToken ;
    skos:definition "Relates an gmeow:Argument (the inference-slice argumentation node) to the gmeow:ClaimToken it attacks — the coarse, flat 80%-case attack edge. The attack pole of bipolar argumentation; the support counterpart is gmeow:supportsClaim. The reified, TYPED promotion (naming WHAT — premise / warrant / conclusion — and HOW) is the inference-slice gmeow:Attack, which this property gmeow:pairsWith. Non-functional; competing attacks coexist (Principle 9). Distinct from gmeow:hasDefeatStatus (a solver-set verdict flag): attacksClaim records the structural attack relation, not the adjudicated outcome."@x-gmeow-english ;
    skos:example "ex:counterArg gmeow:attacksClaim ex:tok1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating it with the adjudicated verdict (gmeow:hasDefeatStatus) — an attack is structural, a verdict is the solver's call; and for a fine-grained typed attack (target + kind) use the reified gmeow:Attack rather than this coarse flat edge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point an gmeow:Argument at the gmeow:ClaimToken it attacks for the flat case; promote to a reified gmeow:Attack (gmeow:pairsWith) when the attack must name its gmeow:attackTarget and gmeow:attackKind."@x-gmeow-english ;
    gmeow:pairsWith gmeow:Attack ;
    gmeow:useWhen "Use to record that an gmeow:Argument attacks a claim token — the coarse flat attack pole of bipolar argumentation; reify with gmeow:Attack for the typed form."@x-gmeow-english .

gmeow:attributedKnower
    a owl:ObjectProperty ;
    rdfs:domain gmeow:KnowledgeAttribution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "attributed knower"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent credited with knowing in a gmeow:KnowledgeAttribution — may equal gmeow:attributingAgent for self-attribution. Functional: one attribution credits one knower."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:attributedProposition
    a owl:ObjectProperty ;
    rdfs:domain gmeow:KnowledgeAttribution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "attributed proposition"@x-gmeow-english ;
    rdfs:range gmeow:Proposition ;
    skos:definition "The proposition attributed as known in a gmeow:KnowledgeAttribution. Functional: one attribution is about one proposition. NON-FACTIVE: no truth is entailed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:attributingAgent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:KnowledgeAttribution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "attributing agent"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent making a gmeow:KnowledgeAttribution — who attributes the knowing. Functional: one attribution has one attributer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:basesBeliefOn
    a owl:ObjectProperty ;
    rdfs:domain gmeow:JustificationSubject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "bases belief on"@x-gmeow-english ;
    rdfs:range gmeow:JustificationGround ;
    skos:definition "Relates a gmeow:JustificationSubject to the gmeow:JustificationGround its belief is actually FOUNDED ON — the BASING component of the five-way justification split. Distinct from gmeow:hasAvailableEvidence (what the agent merely has access to): available != used. NOT functional: a belief may be based on several grounds, and competing basings coexist (Principle 9)."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:basesBeliefOn ex:photoEvidence ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for evidence merely available but not used (that is gmeow:hasAvailableEvidence) and for an adequacy verdict (that is gmeow:adequateUnder); basing records which available ground the belief actually rests on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point from a gmeow:DoxasticState or gmeow:StandpointClaim at the gmeow:JustificationGround(s) it is actually founded on; pair with gmeow:hasAvailableEvidence for the wider accessible set."@x-gmeow-english ;
    gmeow:useWhen "Use to record which available ground a belief is actually based on — the basing relation, distinct from mere availability."@x-gmeow-english .

gmeow:believes
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "believes"@x-gmeow-english ;
    skos:definition "An agent holds a proposition to be true — the base doxastic attitude. Range is intentionally OPEN: the object may be a gmeow:Proposition, a reified statement, or any claim the agent holds (the five-minute-gate shortcut, Principle 13); the typed content link arrives at the reified doxastic state (DoxasticState). Non-functional — an agent holds many beliefs, and contested beliefs coexist (Principle 9). How strongly, and from whose vantage, rides gmeow:standpointModality and gmeow:accordingTo on the statement, never a truth bit here."@x-gmeow-english ;
    skos:example "ex:alice gmeow:believes ex:earthIsRound ."@x-gmeow-english ;
    skos:scopeNote "believes is documented — not axiomatised — as riding gmeow:accordingTo on the statement (an owl:ObjectProperty cannot rdfs:subPropertyOf an owl:AnnotationProperty in OWL 2 DL; the gmeow:vantage / gmeow:accordingTo precedent). Realised in the projection layer."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as a global truth claim — believing is one agent's held attitude, never a factive knowledge verdict; for a merely entertained premise use gmeow:accepts (no belief), for the justified case use gmeow:knowsThat, and never force one belief to win in a merge (it is non-functional)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the agent at a gmeow:Proposition or reified statement; carry strength and frame on gmeow:standpointModality / gmeow:accordingTo of the statement, and promote to the reified doxastic state (DoxasticState) only when credence, justification, or the mental moment must be first-class."@x-gmeow-english ;
    gmeow:pairsWith gmeow:DoxasticState ;
    gmeow:useWhen "Use to record that an agent holds a proposition (or any reified statement / claim) to be true — the base doxastic attitude and the cheap 80% surface; how strongly and from whose vantage ride gmeow:standpointModality and gmeow:accordingTo on the holding statement."@x-gmeow-english .

gmeow:claimOfBelief
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DoxasticStandpointClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "claim of belief"@x-gmeow-english ;
    rdfs:range gmeow:DoxasticState ;
    skos:definition "Relates a DoxasticStandpointClaim to the DoxasticState it reports — the held believing mode that the claim is about. Functional: one such claim reports exactly one held doxastic state."@x-gmeow-english ;
    skos:example "ex:aliceRoundClaim gmeow:claimOfBelief ex:aliceBelievesRound ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it outside a DoxasticStandpointClaim; for the flat spine, link the agent directly to the proposition with gmeow:believes or gmeow:knowsThat."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly once per DoxasticStandpointClaim, pointing to the DoxasticState whose agent, proposition, and claimModality match the claim's vantage, observedFeature, and modality."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a DoxasticStandpointClaim to the reified DoxasticState whose belief it reports."@x-gmeow-english .

gmeow:claimsToKnowThat
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "claims to know that"@x-gmeow-english ;
    skos:definition "An agent CLAIMS to know a proposition — a reported, NON-FACTIVE knowledge-attribution attitude ('they take themselves to know'), never collapsed into the locally-factive gmeow:knowsThatIn / gmeow:KnowledgeClaim. Entails neither truth nor a world. NOT a subproperty of gmeow:knowsThat / gmeow:believes / gmeow:knowsThatIn. Range OPEN. Non-functional. The reified tier is gmeow:KnowledgeAttribution."@x-gmeow-english ;
    skos:example "ex:alice gmeow:claimsToKnowThat ex:earthIsRound ."@x-gmeow-english ;
    skos:scopeNote "claimsToKnowThat carries no world, no standard, and no factivity; it is a reported attitude, the analogue of a third-party 'X says they know'. It MUST NOT be a subproperty of any factive or doxastic-spine property."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as factive or as belief — it is a reported claim to know, never the locally-factive gmeow:knowsThatIn nor the non-factive belief gmeow:knowsThat; use gmeow:KnowledgeAttribution to reify the (attributer, knower, proposition) when it must be first-class."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the agent at the proposition it claims to know; reify with gmeow:KnowledgeAttribution when the attributing agent differs from the knower or the attribution itself is a fact of interest."@x-gmeow-english ;
    gmeow:useWhen "Use to record that an agent claims (takes itself) to know a proposition — a non-factive reported attitude, kept strictly separate from the locally-factive knowledge relation."@x-gmeow-english .

gmeow:credence
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DoxasticState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "credence"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "A graded degree-of-belief in the closed interval [0,1], attached to a DoxasticState. Non-functional: an agent's credence may be reported by multiple sources or updated over time, and those reports coexist (Principle 9). Distinct from gmeow:confidence (our certainty about a statement, in the provenance/statement layer) and from claimModality (qualitative standpoint belief value on the linked StandpointClaim)."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:credence \"0.92\"^^xsd:decimal ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the flat gmeow:believes spine (use gmeow:standpointModality on the statement instead) and avoid conflating it with gmeow:confidence or gmeow:claimModality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Attach one or more xsd:decimal values in [0,1] to a DoxasticState; pair with doxasticClaim carrying claimModality for the qualitative side."@x-gmeow-english ;
    gmeow:useWhen "Use to record a numeric degree-of-belief on a reified DoxasticState when graded strength is itself first-class."@x-gmeow-english .

gmeow:defeatedBy
    a owl:ObjectProperty ;
    rdfs:domain gmeow:JustificationSubject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "defeated by"@x-gmeow-english ;
    rdfs:range gmeow:Defeater ;
    skos:definition "Relates a gmeow:JustificationSubject (a gmeow:DoxasticState or gmeow:StandpointClaim) to the structural gmeow:Defeater that defeats it — an gmeow:Argument, a defeating gmeow:StandpointClaim, or a defeating gmeow:EvidenceSpan. The DEFEAT component of the five-way justification split, recording WHAT does the defeating. Distinct from the solver-set verdict FLAG gmeow:hasDefeatStatus -> gmeow:JustificationStatus, which records the adjudicated outcome (Gettier / defeated / undercut / rebutted). NOT functional: several defeaters may bear on one subject, and old ones are suppressed rather than erased (Principle 10)."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:defeatedBy ex:counterEvidence ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at a gmeow:JustificationStatus value (that is the flag gmeow:hasDefeatStatus) — gmeow:defeatedBy names the structural defeater (an Argument, claim, or evidence span), not the verdict; and avoid treating it as a deletion signal (pair with gmeow:displayable false, Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point from a gmeow:DoxasticState or gmeow:StandpointClaim at the gmeow:Defeater(s) that defeat it (an gmeow:Argument, gmeow:StandpointClaim, or gmeow:EvidenceSpan); record the adjudicated outcome separately with gmeow:hasDefeatStatus."@x-gmeow-english ;
    gmeow:useWhen "Use to record the structural defeater(s) bearing on a reified gmeow:DoxasticState or gmeow:StandpointClaim — what does the defeating — keeping the solver's verdict flag on gmeow:hasDefeatStatus."@x-gmeow-english .

gmeow:doubts
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "doubts"@x-gmeow-english ;
    skos:definition "An agent holds a proposition in doubt — a low-credence, unsettled doxastic attitude: weaker than believing, and distinct from settled disbelief (a refuted gmeow:standpointModality on the statement). Range OPEN, like gmeow:believes. Non-functional."@x-gmeow-english ;
    skos:example "ex:alice gmeow:doubts ex:earthIsRound ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for settled disbelief (that is a refuted gmeow:standpointModality on the statement, a standpoint's explicit denial, never a factive knowledge verdict) and for full agnostic withholding (use gmeow:suspendsJudgementOn); doubt is a leaning, not a balanced suspension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the agent at the proposition or reified statement; if the doubt hardens into denial, model that as a refuted gmeow:standpointModality on a StandpointClaim rather than overloading gmeow:doubts, and let competing attitudes coexist (it is non-functional)."@x-gmeow-english ;
    gmeow:useWhen "Use to record an agent's low-credence, unsettled leaning against a proposition — weaker than belief and not yet settled disbelief — when the wavering itself is what you want to capture."@x-gmeow-english .

gmeow:doxasticClaim
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DoxasticState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "doxastic claim"@x-gmeow-english ;
    rdfs:range gmeow:StandpointClaim ;
    skos:definition "The StandpointClaim that carries the qualitative belief value (claimModality) for a DoxasticState. Reuses the existing standpoint vocabulary without domain-clashing claimModality (whose domain is StandpointClaim) onto DoxasticState (Principle 6). The claim's vantage is the believing agent, its observedFeature is the proposition, and its claimModality is the qualitative value (unequivocal, probable, conceivable, refuted, bullshit)."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:doxasticClaim ex:aliceRoundClaim . ex:aliceRoundClaim a gmeow:StandpointClaim ; gmeow:vantage ex:alice ; gmeow:observedFeature ex:earthIsRound ; gmeow:claimModality gmeow:unequivocal ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting claimModality directly on a DoxasticState — its domain is StandpointClaim; use this bridge instead."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Set exactly once per DoxasticState, pointing to a StandpointClaim whose vantage and observedFeature match the doxastic state's agent and proposition."@x-gmeow-english ;
    gmeow:useWhen "Use when the reified doxastic state needs a qualitative standpoint modality; the linked StandpointClaim carries claimModality."@x-gmeow-english .

gmeow:doxasticContent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DoxasticState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "doxastic content"@x-gmeow-english ;
    rdfs:range gmeow:Proposition ;
    skos:definition "The Proposition that is the content of a DoxasticState — what the agent believes. Functional and constitutive: one doxastic state is directed at exactly one proposition."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:doxasticContent ex:earthIsRound ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the flat spine: gmeow:believes already points from agent to proposition directly."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly once per DoxasticState, pairing it with epistemicAgent and doxasticClaim."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a DoxasticState to the truth-apt proposition it is about."@x-gmeow-english .

gmeow:epistemicAgent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DoxasticState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "epistemic agent"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent in whom a DoxasticState inheres — the believer. Functional and constitutive: one doxastic state is the believing mode of exactly one agent."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:epistemicAgent ex:alice ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid as a generic agent link; it names a constitutive role of the reified doxastic state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly once per DoxasticState, pairing it with doxasticContent and doxasticClaim."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a DoxasticState to the agent whose believing mode it is."@x-gmeow-english .

gmeow:evaluates
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ClaimEvaluation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "evaluates"@x-gmeow-english ;
    rdfs:range gmeow:ClaimToken ;
    skos:definition "The claim token a gmeow:ClaimEvaluation assesses. Each evaluation evaluates exactly one target token; a token may be assessed by many coexisting evaluations under different contexts (Principle 9). Distinct from gmeow:expresses (which carries the evaluation's own verdict proposition) and gmeow:heldByAttitude: gmeow:evaluates names the SUBJECT of the assessment — the assertion act being judged."@x-gmeow-english ;
    skos:example "ex:eval1 gmeow:evaluates ex:tok1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at a bare gmeow:Proposition (evaluate the token, not the content) or at a gmeow:DoxasticState; the target is the assertion act (gmeow:ClaimToken)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set once per gmeow:ClaimEvaluation, pointing at the target gmeow:ClaimToken; carry the evaluation's context on inherited gmeow:accordingTo and its verdict on the proposition it gmeow:expresses."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a gmeow:ClaimEvaluation to the single claim token it assesses."@x-gmeow-english .

gmeow:expresses
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ClaimToken ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "expresses"@x-gmeow-english ;
    rdfs:range gmeow:Proposition ;
    skos:definition "The propositional content a claim token puts forward — the gmeow:Proposition it conveys. The content axis of the claim separation: a claim token may express several propositions, and a proposition may be expressed by many coexisting tokens (Principle 9). Distinct from gmeow:doxasticContent (which links the held DoxasticState to the same proposition from the attitude side) and from gmeow:observedFeature (the Observation-spine role the generated union view materialises from this property). The proposition is a first-class content identity, separate from the assertion act that expresses it."@x-gmeow-english ;
    skos:example "ex:tok1 gmeow:expresses ex:earthIsRound ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the held attitude (gmeow:heldByAttitude) or the asserting agent (gmeow:wasAssociatedWith); expresses names only the truth-apt content the token conveys. Avoid asserting the expressed proposition as a global fact — a Proposition asserts nothing by itself."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the gmeow:ClaimToken at one or more gmeow:Proposition individuals; the generated observation union view materialises gmeow:observedFeature from these so generic observation consumers find them. Retract a token by suppression without touching the proposition it expressed (Principle 10)."@x-gmeow-english ;
    gmeow:useWhen "Use to name the truth-apt proposition(s) a claim token asserts, denies, entertains, or assumes — the content axis of the four-way separation, kept distinct from the act, the attitude, and the evaluation."@x-gmeow-english .

gmeow:groundsClaim
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MentalMoment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "grounds claim"@x-gmeow-english ;
    rdfs:range gmeow:ClaimToken ;
    skos:definition "Relates a held attitude — a gmeow:DoxasticState (belief) or a teleology gmeow:IntentionalMode (desire / intention), both gmeow:MentalMoment — to a claim token it grounds. The attitude→token canonical link, inverse of gmeow:heldByAttitude. Non-functional: one held attitude may ground several coexisting tokens (re-asserted on different occasions, to different audiences) or none (an attitude never put forward). Distinct from gmeow:doxasticClaim, which links a DoxasticState to its standpoint-slice gmeow:StandpointClaim VIEW; groundsClaim links to the canonical claim token, the assertion act itself."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:groundsClaim ex:tok1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating it with gmeow:doxasticClaim (the StandpointClaim view link) or with the content link gmeow:doxasticContent; groundsClaim points at the canonical assertion act, not the content and not the projected view."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a gmeow:DoxasticState (or teleology gmeow:IntentionalMode) at each gmeow:ClaimToken it grounds; read gmeow:heldByAttitude by inversion from the token side. Leave absent for a held attitude never put forward as a claim."@x-gmeow-english ;
    gmeow:useWhen "Use from a held attitude to reach the claim token(s) it grounds — the attitude-rooted direction of the attitude↔token link."@x-gmeow-english .

gmeow:hasAvailableEvidence
    a owl:ObjectProperty ;
    rdfs:domain gmeow:JustificationSubject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "has available evidence"@x-gmeow-english ;
    rdfs:range gmeow:JustificationGround ;
    skos:definition "Relates a gmeow:JustificationSubject to a gmeow:JustificationGround the agent HAS ACCESS TO — the AVAILABLE-EVIDENCE component of the five-way justification split. Distinct from gmeow:basesBeliefOn (the ground actually used): available != used. NOT functional: many grounds may be available, and they coexist (Principle 9). Records only availability, never adequacy (that is gmeow:adequateUnder, Principle 12)."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:hasAvailableEvidence ex:photoEvidence , ex:expertAttestation ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as the basing ground (that is gmeow:basesBeliefOn) or as an adequacy verdict (gmeow:adequateUnder); availability is only that the ground is accessible as a potential basis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point from a gmeow:DoxasticState or gmeow:StandpointClaim at the gmeow:JustificationGround(s) accessible to the agent; mark which are actually used with gmeow:basesBeliefOn."@x-gmeow-english ;
    gmeow:useWhen "Use to record the evidence available to an agent as a potential basis — the accessible set, distinct from what the belief is actually based on."@x-gmeow-english .

gmeow:hasDefeatStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:JustificationSubject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "has defeat status"@x-gmeow-english ;
    rdfs:range gmeow:JustificationStatus ;
    skos:definition "A gmeow:JustificationSubject (a gmeow:DoxasticState or gmeow:StandpointClaim) is marked with a justification-defeat STATUS — a solver-set flag such as Gettier-case, defeated, undermined, undercut, or rebutted. The adjudicated VERDICT, distinct from the structural defeater gmeow:defeatedBy -> gmeow:Defeater (which records what does the defeating). Non-functional: a subject may carry several markers over time, and old markers are suppressed rather than erased (Principle 10). A solver annotation only; the reasoner never promotes or retracts it (Principle 12)."@x-gmeow-english ;
    skos:example "ex:aliceBelievesRound gmeow:hasDefeatStatus gmeow:justificationStatusGettier ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at the structural defeater (that is gmeow:defeatedBy -> gmeow:Defeater) or treating it as a reasoner-entailed truth bit or deletion signal; pair with gmeow:displayable false for suppressed defeated claims (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point from a gmeow:DoxasticState or gmeow:StandpointClaim at one or more gmeow:JustificationStatus individuals; record what does the defeating separately with gmeow:defeatedBy; update by minting a new status link and suppressing the old one (Principle 10)."@x-gmeow-english ;
    gmeow:useWhen "Use to flag that a reified gmeow:DoxasticState or gmeow:StandpointClaim has a known justification problem (Gettier case, defeated, undermined, undercut, rebutted) as determined by the solver layer."@x-gmeow-english .

gmeow:heldByAttitude
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ClaimToken ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "held by attitude"@x-gmeow-english ;
    rdfs:range gmeow:MentalMoment ;
    owl:inverseOf gmeow:groundsClaim ;
    skos:definition "The held attitude a claim token reports — a gmeow:DoxasticState (belief) or a teleology gmeow:IntentionalMode (desire / intention), the kernel gmeow:MentalMoment parent covering both without re-minting per attitude family (Principle 6). The token-rooted inverse of gmeow:groundsClaim. OPTIONAL by design: a token with no attitude is one asserted without a reported private attitude, and a proposition held as an attitude with NO token is one merely entertained or assumed without being put forward (the canon 'an attitude need not be expressed by any token')."@x-gmeow-english ;
    skos:example "ex:tok1 gmeow:heldByAttitude ex:aliceBelievesRound ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the propositional content (gmeow:expresses) or the asserting agent (gmeow:wasAssociatedWith); leave it absent to model a merely entertained or assumed token, or a sincerity gap where the projected token diverges from the held attitude."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it as the inverse of gmeow:groundsClaim from the token side; point a doxastic token at its gmeow:DoxasticState, a conative token at its gmeow:IntentionalMode. Omit it to model entertaining or assuming without holding the attitude."@x-gmeow-english ;
    gmeow:useWhen "Use from a claim token to reach the attitude it reports (belief, desire, intent) — the token-rooted inverse of the attitude→token gmeow:groundsClaim edge."@x-gmeow-english .

gmeow:justificationStatusDefeated
    a gmeow:JustificationStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "defeated"@x-gmeow-english ;
    skos:definition "A generic defeated marker — the justification for the target doxastic state or standpoint-claim has been undermined by some defeater. A solver-set flag only; never reasoner-promoted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:justificationStatusGettier
    a gmeow:JustificationStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "Gettier case"@x-gmeow-english ;
    skos:definition "A Gettier-case marker — the subject has a justified true belief that falls short of knowledge because the justification is defective or accidentally related to the truth. A solver-set flag only; never reasoner-promoted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:justificationStatusRebutted
    a gmeow:JustificationStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "rebutted"@x-gmeow-english ;
    skos:definition "A rebutting justification-defeat marker — positive reason has been given to believe the negation of the target doxastic state or standpoint-claim, attacking the conclusion directly. Aligns with gmeow:attackRebut in the inference slice. A solver-set flag only; never reasoner-promoted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:justificationStatusUndercut
    a gmeow:JustificationStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "undercut"@x-gmeow-english ;
    skos:definition "An undercutting justification-defeat marker — the inferential or evidential link supporting the target is attacked, removing the warrant without asserting the target's negation. Aligns with gmeow:attackUndercut in the inference slice. A solver-set flag only; never reasoner-promoted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:justificationStatusUndermined
    a gmeow:JustificationStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "undermined"@x-gmeow-english ;
    skos:definition "An undermining justification-defeat marker — a premise the target relies on has been attacked. Aligns with gmeow:attackUndermine in the inference slice (the premise-directed third typed-attack kind). A solver-set flag only; never reasoner-promoted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:knowerAgent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:KnowledgeClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "knower agent"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent who knows in a reified gmeow:KnowledgeClaim. Functional: one knowledge claim, one knower."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:knownInWorld
    a owl:ObjectProperty ;
    rdfs:domain gmeow:KnowledgeClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "known in world"@x-gmeow-english ;
    rdfs:range gmeow:EpistemicContext ;
    skos:definition "The belief-world a gmeow:KnowledgeClaim is locally factive IN — the gmeow:EpistemicContext relative to which the known proposition holds. Functional: one knowledge claim, one world. Local factivity is world-relative: knowing P in this world entails P holds in this world, never globally (recorded by prose, never an asserted truth bit)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:knownProposition
    a owl:ObjectProperty ;
    rdfs:domain gmeow:KnowledgeClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "known proposition"@x-gmeow-english ;
    rdfs:range gmeow:Proposition ;
    skos:definition "The proposition known in a reified gmeow:KnowledgeClaim. Functional: one knowledge claim, one proposition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:knowsThat
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "knows that"@x-gmeow-english ;
    rdfs:subPropertyOf gmeow:believes ;
    skos:definition "An agent knows that a proposition holds — justified, standpoint-true belief held from a vantage. THE KEYSTONE: gmeow:knowsThat rdfs:subPropertyOf gmeow:believes, so asserting knowsThat materialises believes (knowledge entails belief); the reverse never holds. knowsThat is NON-FACTIVE: it carries no truth commitment and no isTrue axiom — it is a vantage-indexed CLAIM that (belief and truth-per-frame and justification) holds, never a global verdict. The reasoner never promotes justified-true-belief to knowledge; that judgement, and any Gettier defeater, is solver work (Principle 12). Range OPEN, like gmeow:believes. Justification is factored in this module into the five components available-evidence (gmeow:hasAvailableEvidence), basing (gmeow:basesBeliefOn), support-under-a-standard (gmeow:supportsUnder), adequacy (gmeow:adequateUnder), and defeat (gmeow:defeatedBy / gmeow:hasDefeatStatus). The locally-factive companion gmeow:knowsThatIn adds a world and a standard."@x-gmeow-english ;
    skos:example "ex:alice gmeow:knowsThat ex:earthIsRound ."@x-gmeow-english ;
    skos:scopeNote "No factive knows: unlike SUMO/CYC knows, asserting gmeow:knowsThat commits the proposition true in NO global model — truth is per-frame (gmeow:standpointModality / gmeow:claimModality, standpoint slice). The only entailment is the safe one: knowsThat implies believes."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as a factive 'knows X is true' verdict — it is NON-FACTIVE, a vantage-indexed claim with no isTrue axiom; promotion of justified-true-belief to knowledge and any Gettier defeater is solver work (Principle 12), never a reasoner entailment, and truth stays per-frame on gmeow:standpointModality / gmeow:claimModality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the agent at the proposition or reified statement; carry truth-per-frame on gmeow:standpointModality / gmeow:accordingTo of the holding statement, factor justification via gmeow:hasAvailableEvidence / gmeow:basesBeliefOn / gmeow:supportsUnder / gmeow:adequateUnder / gmeow:defeatedBy declared in this module, and rely only on the safe entailment knowsThat ⊑ believes — never on a global truth bit."@x-gmeow-english ;
    gmeow:useWhen "Use to record justified, standpoint-true belief held from a vantage — the keystone knowledge-that attitude; asserting it materialises gmeow:believes (knowledge entails belief), so reach for it only when the holding is justified, not merely held."@x-gmeow-english .

gmeow:knowsThatIn
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "knows that in"@x-gmeow-english ;
    skos:definition "An agent knows that a proposition holds IN a belief-world — the flat, LOCALLY-FACTIVE knowledge surface (the 80% case): knowing P in world W entails P holds IN W, never globally. The reified promotion target carrying the world and the standard is gmeow:KnowledgeClaim. DISTINCT from the non-factive gmeow:knowsThat (a vantage-indexed claim with no world): knowsThatIn is locally factive and world-indexed. Range OPEN, like gmeow:knowsThat. Non-functional."@x-gmeow-english ;
    skos:example "ex:ada gmeow:knowsThatIn ex:earthOrbitsSun ."@x-gmeow-english ;
    skos:scopeNote "knowsThatIn is NOT rdfs:subPropertyOf gmeow:knowsThat or gmeow:believes — a subproperty edge would pollute the non-factive doxastic spine with factivity; the two are SIBLINGS. Local factivity (knowing P in W ⇒ P holds in W) is recorded by PROSE reference (Principle 5), never asserted: no gmeow:isTrue, no factivity OWL axiom, no asserted logic: triple — the world-indexed rule stays central in the logic slice over the world-relative hold predicate, keeping factivity honest in a paraconsistent setting and the DL profile clean."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as a GLOBAL truth verdict — factivity is world-LOCAL (relative to the gmeow:EpistemicContext), never across all worlds; for the non-factive vantage-indexed claim use gmeow:knowsThat, and for a merely reported 'they take themselves to know' use gmeow:claimsToKnowThat / gmeow:KnowledgeAttribution. Never make it a subproperty of the doxastic spine."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the agent at the proposition for the flat case; promote to a reified gmeow:KnowledgeClaim when the belief-world (gmeow:knownInWorld -> gmeow:EpistemicContext) and the gmeow:EpistemicStandard must be first-class. Keep it strictly separate from gmeow:knowsThat / gmeow:believes."@x-gmeow-english ;
    gmeow:pairsWith gmeow:KnowledgeClaim ;
    gmeow:useWhen "Use to record locally-factive knowledge — that an agent knows P holds in a particular belief-world — distinct from the non-factive gmeow:knowsThat; the world and standard ride the reified gmeow:KnowledgeClaim."@x-gmeow-english .

gmeow:meetsThreshold
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AdequacyAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "meets threshold"@x-gmeow-english ;
    rdfs:range gmeow:AdequacyVerdict ;
    skos:definition "The solver-set verdict of a gmeow:AdequacyAssessment — whether the support meets the standard's threshold (gmeow:adequacyMet / gmeow:adequacyUnmet / gmeow:adequacyUndetermined). Functional: one assessment, one verdict. A solver value (Principle 12); there is no asserted 'adequate' bit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:producesClaim
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Event ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "produces claim"@x-gmeow-english ;
    rdfs:range gmeow:ClaimToken ;
    skos:definition "A claim token produced during an observing, speech, or deliberation event — the event→token link. One event (a survey, a hearing, a press conference, a reasoning episode) may produce several claim tokens, and those coexist (Principle 9). The event view of where a claim came from; for the performing agent of a single act use the token's own gmeow:wasAssociatedWith (the token is a gmeow:Activity)."@x-gmeow-english ;
    skos:example "ex:hearing2026 gmeow:producesClaim ex:tok1 , ex:tok2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the performing agent of a single act (use gmeow:wasAssociatedWith on the token) and for the held attitude (gmeow:heldByAttitude); producesClaim ties a broader event to the tokens uttered within it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point an gmeow:Event at each gmeow:ClaimToken uttered within it; a single observing event producing several claims is the canonical 'one observation, several claims' case."@x-gmeow-english ;
    gmeow:useWhen "Use from an event to reach the claim tokens it produced — for 'one observation producing several claims' and event-rooted provenance."@x-gmeow-english .

gmeow:standardLegalBeyondReasonableDoubt
    a gmeow:EpistemicStandard ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "beyond reasonable doubt"@x-gmeow-english ;
    skos:definition "The criminal-law standard — the strictest practical threshold: the evidence must leave no reasonable doubt. The highest of the seeded gmeow:EpistemicStandard values."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:standardLegalClearAndConvincing
    a gmeow:EpistemicStandard ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "clear and convincing"@x-gmeow-english ;
    skos:definition "The intermediate legal standard — the evidence must make the claim highly probable, stricter than preponderance but short of beyond-reasonable-doubt."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:standardLegalPreponderance
    a gmeow:EpistemicStandard ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "preponderance of the evidence"@x-gmeow-english ;
    skos:definition "The civil-law standard — the claim is more likely true than not (> 50%). The most lenient of the seeded legal gmeow:EpistemicStandard values."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:standardOrdinary
    a gmeow:EpistemicStandard ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "ordinary"@x-gmeow-english ;
    skos:definition "The everyday standard of 'knowing' — the ordinary threshold of warranted assertion in common life, below the deliberate rigour of the scientific or legal standards."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:standardScientific
    a gmeow:EpistemicStandard ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "scientific"@x-gmeow-english ;
    skos:definition "The scientific-evidential standard — the threshold of warranted assertion under methodical inquiry (controlled evidence, replication, declared confidence), distinct from the ordinary and legal standards."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:supportGround
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SupportAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "support ground"@x-gmeow-english ;
    rdfs:range gmeow:JustificationGround ;
    skos:definition "The gmeow:JustificationGround whose warranting strength a gmeow:SupportAssessment measures. Functional: one assessment weighs one ground (under one standard)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:supportStrength
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:SupportAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "support strength"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "A solver-computed measure of how strongly a gmeow:SupportAssessment's ground warrants its content under the named standard. A solver-layer value (Principle 12), not an asserted adequacy verdict (that is gmeow:meetsThreshold). NOT functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:supportUnderStandard
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SupportAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "support under standard"@x-gmeow-english ;
    rdfs:range gmeow:EpistemicStandard ;
    skos:definition "The named epistemic standard a gmeow:SupportAssessment measures support relative to. Functional: one assessment, one standard."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:supportsClaim
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Argument ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "supports claim"@x-gmeow-english ;
    rdfs:range gmeow:ClaimToken ;
    skos:definition "Relates an gmeow:Argument (the inference-slice argumentation node) to the gmeow:ClaimToken it supports — the coarse, flat 80%-case support edge. The support pole of bipolar argumentation; the attack counterpart is gmeow:attacksClaim. The reified, accruing promotion is the inference-slice gmeow:Support, which this property gmeow:pairsWith. Non-functional: many arguments may support one token, and competing support/attack relations coexist (Principle 9). Distinct from gmeow:basesBeliefOn (which bases a DoxasticState on grounds) — supportsClaim targets the claim TOKEN — and from gmeow:hasDefeatStatus (an adjudicated solver verdict) — support is a structural relation, not a verdict."@x-gmeow-english ;
    skos:example "ex:arg1 gmeow:supportsClaim ex:tok1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for justification grounds on a DoxasticState (that is gmeow:basesBeliefOn); and for accruing reified support use the inference-slice gmeow:Support rather than this coarse flat edge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point an gmeow:Argument at the gmeow:ClaimToken it supports for the flat case; promote to a reified gmeow:Support (gmeow:pairsWith) when support must accrue from several independent sources."@x-gmeow-english ;
    gmeow:pairsWith gmeow:Support ;
    gmeow:useWhen "Use to record that an gmeow:Argument supports a claim token — the coarse flat support pole of bipolar argumentation; reify with gmeow:Support for accrual."@x-gmeow-english .

gmeow:supportsUnder
    a owl:ObjectProperty ;
    rdfs:domain gmeow:JustificationSubject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "supports under"@x-gmeow-english ;
    rdfs:range gmeow:SupportAssessment ;
    skos:definition "Relates a gmeow:JustificationSubject (a gmeow:DoxasticState or gmeow:StandpointClaim) to a reified gmeow:SupportAssessment — how strongly its evidence warrants the content RELATIVE TO a named epistemic standard. The SUPPORT-UNDER-A-STANDARD component of the five-way justification split. NOT functional: support may be assessed under several standards, and those assessments coexist (Principle 9). A solver judgement (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:suspendsJudgementOn
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "suspends judgement on"@x-gmeow-english ;
    skos:definition "An agent neither believes nor disbelieves a proposition — a third, agnostic doxastic stance (withholding), distinct from doubt (a leaning) and from silence (no recorded attitude). Range OPEN. Non-functional."@x-gmeow-english ;
    skos:example "ex:alice gmeow:suspendsJudgementOn ex:earthIsRound ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a directional leaning against the proposition (use gmeow:doubts) and for an unexamined gap where the agent simply has no recorded view; suspension is a held stance, never an absence and never a factive knowledge verdict about the proposition's truth."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the agent at the proposition or reified statement to assert the withholding explicitly; keep it distinct from doubt and from silence, and let it coexist with other agents' attitudes on the same proposition (it is non-functional)."@x-gmeow-english ;
    gmeow:useWhen "Use to record an explicit agnostic stance — the agent has considered the proposition and withholds, neither believing nor disbelieving it — so suspension is distinguishable from mere silence (no recorded attitude)."@x-gmeow-english .

gmeow:takesAsKnown
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "takes as known"@x-gmeow-english ;
    skos:definition "An agent treats a proposition AS KNOWN for the purposes of reasoning or action — a working stance, the doxastic analogue of gmeow:accepts: it entails NEITHER truth NOR the locally-factive gmeow:KnowledgeClaim, and is deliberately not a subproperty of gmeow:knowsThat / gmeow:knowsThatIn / gmeow:believes. Range OPEN. Non-functional."@x-gmeow-english ;
    skos:example "ex:alice gmeow:takesAsKnown ex:earthIsRound ."@x-gmeow-english ;
    skos:scopeNote "takesAsKnown is the 'assume as known for the argument' stance — pragmatic, non-factive, carrying no world or standard; it MUST NOT be a subproperty of any factive or doxastic-spine property (the gmeow:accepts precedent)."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as genuine knowledge or belief — it is a working stance (take P as known for reasoning), never the locally-factive gmeow:knowsThatIn nor a held belief; for a genuine knowledge claim use gmeow:knowsThatIn."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the agent at the proposition it treats as known for a line of reasoning or a policy default; keep it strictly separate from the factive knowledge relation so the projection layer never promotes it."@x-gmeow-english ;
    gmeow:useWhen "Use to record that an agent takes a proposition as known for reasoning or action WITHOUT thereby knowing or believing it — the knowledge analogue of pragmatic acceptance."@x-gmeow-english .

gmeow:tenureOfDoxasticState
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DoxasticTenure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "tenure of doxastic state"@x-gmeow-english ;
    rdfs:range gmeow:DoxasticState ;
    skos:definition "Relates a DoxasticTenure to the DoxasticState whose holding interval it records. Functional: one tenure scopes one doxastic state; a revised belief gets a new DoxasticState and a new tenure, while the old state and closed tenure remain as audit (Principle 10)."@x-gmeow-english ;
    skos:example "ex:aliceRoundTenure gmeow:tenureOfDoxasticState ex:aliceBelievesRound ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the interval (use duringInterval) and avoid pointing at more than one doxastic state per tenure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly once per DoxasticTenure, pairing it with duringInterval."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a DoxasticTenure to the DoxasticState it time-scopes."@x-gmeow-english .

gmeow:underStandard
    a owl:ObjectProperty ;
    rdfs:domain gmeow:KnowledgeClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "under standard"@x-gmeow-english ;
    rdfs:range gmeow:EpistemicStandard ;
    skos:definition "The epistemic standard a reified gmeow:KnowledgeClaim is held to — the gmeow:EpistemicStandard (ordinary / scientific / legal) under which the knowing counts. Functional: one knowledge claim, one standard."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/epistemics>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """The propositional companion to the cognition slice (objectual, agent to entity): epistemics relates an agent to a PROPOSITION, not to an entity.

DOCTRINE.
  * Keystone: gmeow:knowsThat rdfs:subPropertyOf gmeow:believes — knowledge is justified, standpoint-true belief held from a vantage, and there is NO factive knows. Asserting knowsThat materialises believes; the reverse never holds; neither commits global truth. The reasoner never promotes justified-true-belief to knowledge — that verdict (and its Gettier defeaters) is solver work (Principle 12).
  * No truth bit: there is no isTrue, no truth datatype, no factivity axiom anywhere. Truth-per-frame rides the standpoint modality (gmeow:standpointModality on a flattened statement, gmeow:claimModality on a reified StandpointClaim), reused from the standpoint slice, never re-minted (Principle 6).
  * Locally-factive knowledge (design/LOGIC-FOUNDATION.md): the non-factive gmeow:knowsThat has a SIBLING gmeow:knowsThatIn — knowing P in a belief-world W entails P holds IN W, never globally. The reified gmeow:KnowledgeClaim carries the world (gmeow:knownInWorld -> gmeow:EpistemicContext) and the standard (gmeow:underStandard -> gmeow:EpistemicStandard); it is a CLAIM apparatus (logic:Relator), deliberately NOT a kernel:MentalMoment (the attitude stays gmeow:DoxasticState). Local factivity is recorded by PROSE only — no gmeow:isTrue, no factivity axiom, no asserted logic: triple; the world-indexed rule stays central in the logic slice. NON-FACTIVE knowledge-attribution ('they take themselves to know') is kept strictly separate: gmeow:claimsToKnowThat / gmeow:takesAsKnown (flat) and gmeow:KnowledgeAttribution (reified), none a subproperty of the factive or doxastic spine.
  * Flat-first (Principle 4 / Principle 13): the believes / doubts / suspendsJudgementOn / accepts / knowsThat spine is the cheap 80% surface with an OPEN range (point at any reified statement or claim). The reified tier (DoxasticState, credence, doxasticClaim, DoxasticTenure) and the mental-moment grounding live in this module as the promotion target when credence, temporal scope, or standpoint modality must be first-class.
  * Factored justification (five components, design/LOGIC-FOUNDATION.md): available-evidence (gmeow:hasAvailableEvidence), basing (gmeow:basesBeliefOn — available != used), support-under-a-standard (gmeow:supportsUnder -> gmeow:SupportAssessment), adequacy (gmeow:adequateUnder -> gmeow:AdequacyAssessment, meeting a gmeow:EpistemicStandard threshold), and defeat — split into the structural defeater (gmeow:defeatedBy -> gmeow:Defeater) and the solver-set verdict flag (gmeow:hasDefeatStatus -> gmeow:JustificationStatus). All are solver judgements (Principle 12); full inferential argumentation lives in the inference slice.
  * believes is documented — never axiomatised — as riding gmeow:accordingTo on the statement (an owl:ObjectProperty cannot subproperty an owl:AnnotationProperty in OWL 2 DL; the gmeow:vantage / gmeow:accordingTo precedent). The bridge is realised in the projection layer.
  * Acceptance is not belief: gmeow:accepts is pragmatic (a premise taken on for argument) and entails neither belief nor truth (Principle 1)."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "GMEOW Epistemics Module"@x-gmeow-english ;
    skos:definition "The GMEOW Epistemics Module — propositional epistemic relations: an agent's attitudes toward propositions/claims (belief, doubt, suspension, pragmatic acceptance, non-factive knowledge-that, and locally-factive knowledge-in-a-world), with factored justification and non-factive knowledge-attribution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms (core slices) — the closed-world
# cardinality / class / datatype obligations the hand-authored shapes.ttl
# NodeShapes state, authored here once as OWL restriction axioms and PROJECTED
# to generated/shapes/validation-shapes.ttl by derive_validation_shapes
# (Principle 17). Cross-node / value-keyed (sh:sparql, SPARQLTarget) conditions
# have no OWL antecedent and remain the procedural fragment .
# =========================================================================== #

gmeow:DoxasticStandpointClaim rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:claimOfBelief ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:DoxasticState ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:hasAvailableEvidence ; owl:allValuesFrom gmeow:JustificationGround ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:basesBeliefOn ; owl:allValuesFrom gmeow:JustificationGround ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:hasDefeatStatus ; owl:allValuesFrom gmeow:JustificationStatus ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:defeatedBy ; owl:allValuesFrom gmeow:Defeater ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:supportsUnder ; owl:allValuesFrom gmeow:SupportAssessment ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:adequateUnder ; owl:allValuesFrom gmeow:AdequacyAssessment ] .

gmeow:DoxasticState rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:epistemicAgent ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:doxasticContent ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Proposition ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:doxasticClaim ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:StandpointClaim ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:credence ; owl:allValuesFrom xsd:decimal ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:hasAvailableEvidence ; owl:allValuesFrom gmeow:JustificationGround ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:basesBeliefOn ; owl:allValuesFrom gmeow:JustificationGround ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:hasDefeatStatus ; owl:allValuesFrom gmeow:JustificationStatus ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:defeatedBy ; owl:allValuesFrom gmeow:Defeater ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:supportsUnder ; owl:allValuesFrom gmeow:SupportAssessment ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:adequateUnder ; owl:allValuesFrom gmeow:AdequacyAssessment ] .

gmeow:ClaimEvaluation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:evaluates ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:ClaimToken ] .

gmeow:DoxasticTenure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:tenureOfDoxasticState ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:DoxasticState ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:duringInterval ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:TimeInterval ] .

gmeow:SupportAssessment rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:supportGround ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:JustificationGround ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:supportUnderStandard ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:EpistemicStandard ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:supportStrength ; owl:allValuesFrom xsd:decimal ] .

gmeow:AdequacyAssessment rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:adequacyUnderStandard ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:EpistemicStandard ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:meetsThreshold ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:AdequacyVerdict ] .

gmeow:KnowledgeClaim rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:knowerAgent ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:knownProposition ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Proposition ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:knownInWorld ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:EpistemicContext ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:underStandard ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:EpistemicStandard ] .

gmeow:KnowledgeAttribution rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:attributingAgent ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:attributedKnower ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:attributedProposition ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Proposition ] .

# Closed-world cardinality/value axioms backing the hand-authored SHACL
# well-formedness shapes.
gmeow:StandpointClaim rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:observationMethod ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:ObservationMethod ] .

# exact-one minCount restoration (issue #1194): min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
