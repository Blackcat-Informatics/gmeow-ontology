    skos:example "The declared records are checked against gmeow:RecallOperationOneBudgetConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:budgetOperation ;
    logic:message "An operation allocation belongs to one budget roster; reuse in another plan requires another operation identity." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] , [ logic:termIndex 2 ; logic:termVariable "operation" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:budgetOperation ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "operation" ] ] , [ a logic:Formula ; logic:relation gmeow:budgetOperation ; logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "operation" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] ] ] ] .

gmeow:RecallBudgetTotalBoundConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "recall budget total bound law"@x-gmeow-english ;
    skos:definition "The derived finite sum of operation shares must be at most one. Equal numeric shares from distinct operations contribute separately."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve recall budget total bound law."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying RecallBudgetTotalBoundConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallBudgetTotalBoundConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:RecallBudgetTotalBoundConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:recallBudgetTotal ;
    logic:message "The derived finite sum of operation shares must be at most one. Equal numeric shares from distinct operations contribute separately." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "total" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:recallBudgetTotal ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "total" ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termLessEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "total" ] , [ logic:termIndex 1 ; logic:termLiteral "1.0" ; logic:termLiteralDatatype xsd:decimal ] ] ] ] .

