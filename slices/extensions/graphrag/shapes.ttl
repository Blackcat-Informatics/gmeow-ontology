#
# Closed-world halves of the GraphRAG module's EL axioms.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

gmeow:EmbeddingProvenanceShape
    a sh:NodeShape ;
    rdfs:label "Embedding provenance shape" ;
    sh:targetClass gmeow:Embedding ;
    sh:property [
        sh:path gmeow:embeddingOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Embedding must represent exactly one information object (gmeow:embeddingOf)." ;
    ] ;
    sh:property [
        sh:path gmeow:embeddingModel ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Embedding must name exactly one producing model (gmeow:embeddingModel) — an unattributed vector is the blob this module exists to end (P9)." ;
    ] ;
    sh:property [
        sh:path gmeow:distanceMetric ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Embedding must declare exactly one distance metric — 'near' is meaningless without it (P11's spirit at the vector boundary)." ;
    ] .

gmeow:RetrievalEventShape
    a sh:NodeShape ;
    rdfs:label "Retrieval event shape" ;
    sh:targetClass gmeow:RetrievalEvent ;
    sh:property [
        sh:path gmeow:againstIndex ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A RetrievalEvent must query exactly one index (gmeow:againstIndex); federated retrieval is several events under one parent activity." ;
    ] .

gmeow:ExtractedRelationshipEndsShape
    a sh:NodeShape ;
    rdfs:label "Extracted relationship ends shape" ;
    sh:targetClass gmeow:ExtractedRelationship ;
    sh:property [
        sh:path gmeow:relationshipSource ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An ExtractedRelationship must have exactly one source description (gmeow:relationshipSource)." ;
    ] ;
    sh:property [
        sh:path gmeow:relationshipTarget ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An ExtractedRelationship must have exactly one target description (gmeow:relationshipTarget)." ;
    ] .
