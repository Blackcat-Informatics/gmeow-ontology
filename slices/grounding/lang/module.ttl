    gmeow:gmnAsciiFallback "mul" ;
    gmeow:gmnSpokenLabel "multiply" ;
    gmeow:gmnArity 2 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionAdoptedGlyph ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisTokenCost ;
    gmeow:gmnDispositionRationale "× and mul each cost one pinned cl100k_base token; the conventional infix sign wins without a token penalty and stays distinct from the lang-plane ungrammaticality asterisk." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenMathMultiplication ;
    gmeow:cites gmeow:gmnOpenMathWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

