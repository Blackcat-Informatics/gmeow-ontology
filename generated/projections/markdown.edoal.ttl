<https://blackcatinformatics.ca/gmeow/projections/markdown>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Relation ;
            edoal:uri gmeow:mentions ;
        ] ;
        align:entity2 [
            a edoal:Relation ;
            edoal:uri gmeow:hasWikilink ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.9"^^xsd:double ;
        rdfs:label "mentions → gmeow:hasWikilink (markdown round-trip)"@en ;
    ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "markdown" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → markdown (EDOAL)"@en .
