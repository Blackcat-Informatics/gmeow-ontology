@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix lang:    <https://blackcatinformatics.ca/lang/> .
@prefix logic:   <https://blackcatinformatics.ca/logic/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .

# =============================================================================
# GMEOW mapping DSL — the single authoring source for the alignment layer.
#
# GMEOW's doctrine is "one canonical source, everything else a generated lossy
# projection". The alignment layer is the one place that doctrine was not yet
# applied to itself: the SAME mappings were hand-authored four ways (SSSOM rows,
# EDOAL cells, FnO functions, SPARQL CONSTRUCT executors) and drifted. This
# vocabulary is the recursion: author each mapping ONCE as a gmeow: cell, and
# the registered mappings generator renders the standard artifacts from it.
#
# This file is a SPEC LAYER — grounded in the gmeow: namespace and annotated like
# every GMEOW term, but NOT owl:imports-ed into the reasoned OWL 2 DL core
# (projections are a deliberately lossy, directional VIEW, never reasoned). It is
# the sibling of projections/functions.fno.ttl, not of ontology/modules/*.
# =============================================================================

<https://blackcatinformatics.ca/gmeow/mapping-dsl>
    a owl:Ontology ;
    rdfs:label "GMEOW mapping DSL vocabulary"@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "Authoring vocabulary for cross-ontology alignments and lossy projections; compiled to SSSOM / EDOAL / FnO / SPARQL by the registered mappings generator."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Cell types — the authoring units
# --------------------------------------------------------------------------- #
#
# A cross-ontology term alignment is authored as a native RDF-1.2 asserting
# annotation on the match triple itself — `S <match-predicate> O {| gmeow:sssomFile
# "…" ; … |}` (skos:*Match / owl:equivalent* / owl:sameAs / rdfs:sub*Of) — with the
# `gmeow:sssomFile` discriminator marking the reifier as an alignment cell. It has
# no reified class of its own; the annotation fields below are its surface.

gmeow:ProjectionMapping a owl:Class ;
    rdfs:label "projection mapping"@x-gmeow-english ;
    skos:definition "A directional, possibly lossy downcast from a GMEOW graph pattern to one or more target-vocabulary triples. Always compiles to a SPARQL CONSTRUCT branch; additionally to an EDOAL cell, an FnO function declaration (when it carries a transform), and an SSSOM row (when a profile binding is a one-to-one term linkage flagged emitSssom)."@x-gmeow-english .

gmeow:MappingPattern a owl:Class ;
    rdfs:label "mapping pattern"@x-gmeow-english ;
    skos:definition "The GMEOW-side graph pattern of a projection mapping: its anchor (the node the output hangs on), its projected value, the structural atoms, and any suppression filters, derived bindings or minted nodes."@x-gmeow-english .

gmeow:PatternAtom a owl:Class ;
    rdfs:label "pattern atom"@x-gmeow-english ;
    skos:definition "One triple/path constraint inside a mapping pattern — a subject variable, a predicate (or structured property path), and an object (variable, value individual, or literal), optionally wrapped OPTIONAL."@x-gmeow-english .

gmeow:ProfileBinding a owl:Class ;
    rdfs:label "profile binding"@x-gmeow-english ;
    skos:definition "The per-target-profile face of a projection mapping: the target term it emits for one profile, the EDOAL relation, the transform, the confidence, the SSSOM predicate, and the profile-specific lossy drops. One mapping fans out to several bindings (one source -> different target terms across schema.org / vCard / FOAF)."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Alignment fields (the annotation surface of a native alignment cell)
# --------------------------------------------------------------------------- #
#
# The subject, predicate, and object of an alignment are the reified match triple
# itself (`S <match-predicate> O`), not authored properties. The fields below are the
# `{| … |}` annotation coat carried on the reifier.

gmeow:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@x-gmeow-english ;
    skos:definition "Curator confidence in a correspondence [0.0, 1.0]; rendered as the SSSOM confidence column and the EDOAL edoal:measure."@x-gmeow-english .
gmeow:justification a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "mapping justification"@x-gmeow-english ;
    skos:definition "The SSSOM mapping_justification (defaults to semapv:ManualMappingCuration)."@x-gmeow-english .
gmeow:comment a owl:DatatypeProperty ;
    rdfs:label "mapping comment"@x-gmeow-english ;
    skos:definition "Free-text note carried into the SSSOM comment column."@x-gmeow-english .
gmeow:subjectLabel a owl:DatatypeProperty ;
    rdfs:label "subject label"@x-gmeow-english ;
    skos:definition "Human-readable label of the subject term, emitted as the SSSOM subject_label column (for review without dereferencing)."@x-gmeow-english .
gmeow:objectLabel a owl:DatatypeProperty ;
    rdfs:label "object label"@x-gmeow-english ;
    skos:definition "Human-readable label of the (external) object term, emitted as the SSSOM object_label column (e.g. the Wikidata item's English label)."@x-gmeow-english .
gmeow:sssomFile a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "SSSOM file"@x-gmeow-english ;
    skos:definition "The basename of the mappings/*.sssom.tsv file this row is routed to (e.g. \"gmeow-properties.sssom.tsv\")."@x-gmeow-english .

gmeow:MappingSet a owl:Class ;
    rdfs:label "SSSOM mapping set"@x-gmeow-english ;
    skos:definition "Per-file SSSOM header metadata (set id, license, comment, optional trailer) for one generated mappings/*.sssom.tsv file."@x-gmeow-english .
gmeow:setId a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "mapping set id"@x-gmeow-english ;
    skos:definition "The SSSOM mapping_set_id header value."@x-gmeow-english .
gmeow:license a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "mapping set license"@x-gmeow-english ;
    skos:definition "The SSSOM license header value."@x-gmeow-english .
gmeow:setComment a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "mapping set comment"@x-gmeow-english ;
    skos:definition "The SSSOM comment header value."@x-gmeow-english .
gmeow:setTrailer a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "mapping set trailer"@x-gmeow-english ;
    skos:definition "Optional trailing comment lines appended after the data rows (e.g. forward-looking, commented-out mappings)."@x-gmeow-english .
gmeow:sssomPredicate a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "SSSOM predicate"@x-gmeow-english ;
    skos:definition "For a projection binding flagged emitSssom, the SSSOM mapping predicate of its one-to-one term row (distinct from the EDOAL gmeow:relation axis)."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Declined correspondence — a machine-reviewable "won't-bridge" record
# --------------------------------------------------------------------------- #

gmeow:DeclinedCorrespondence a owl:Class ;
    rdfs:label "declined correspondence"@x-gmeow-english ;
    skos:definition "A deliberately-not-authored cross-ontology bridge to an external vocabulary that carries no resolvable per-term RDF surface — recorded with its rationale, the probed candidate namespace(s), a dated probe verdict, and a revisit condition, so the decision is reviewable data rather than a prose comment. Authoring a live correspondence against such a surface would fabricate a link to a dead IRI (Principle 5), so the bridge is declined until a verifiable namespace appears. It is the bottom of the same preservation lattice the supersession ledger populates — nothing is aligned and nothing is recovered — and carries logic:preservationKind logic:Unsupported, the honest 'cannot be expressed in the target at all' polarity, so the absent bridge is carried and flagged, never silently dropped. Distinct from a live native alignment cell (a resolvable link with a `gmeow:sssomFile`-annotated match triple): a decline has no resolvable alignment target at all, precisely because no resolvable object exists."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    logic:subClassOf [
        a logic:Restriction ;
        logic:onProperty logic:preservationKind ;
        logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ;
    ] .

gmeow:declinedTarget a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "declined target vocabulary"@x-gmeow-english ;
    skos:definition "The external vocabulary a correspondence was declined against, named by its spelled-out label or prefix as a string — NEVER a per-term IRI, because dereferencing one would fabricate the dead link the decline exists to avoid. A collision-prone bare acronym (e.g. the three letters that also name the Experimental Factor Ontology) is forbidden; use the full name."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:intendedRelation a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "intended bridge relation"@x-gmeow-english ;
    skos:definition "The SKOS mapping relation (skos:closeMatch / skos:relatedMatch / skos:broadMatch) that a bridge to the declined target WOULD have used had a resolvable surface existed — recording the design intent so a future revisit can author the bridge directly."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:declineRationale a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "decline rationale"@x-gmeow-english ;
    skos:definition "Why the bridge was declined — the reviewable justification (e.g. the target's per-term RDF export is defunct, its term IRIs do not dereference, or it is a reference inventory with no namespace authority)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:revisitCondition a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "revisit condition"@x-gmeow-english ;
    skos:definition "The condition under which a decline is reopened and the bridge authored — typically that a verifiable, dereferenceable per-term namespace for the target appears."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:candidateNamespace a owl:DatatypeProperty ;
    rdfs:label "candidate namespace"@x-gmeow-english ;
    skos:definition "A probed candidate base for the declined target, carried as a string (never a dereferenced IRI) so a future re-probe has a concrete, reproducible target. Multi-valued: a single declined target may bundle several candidate surfaces."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:probeVerdict a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "probe verdict"@x-gmeow-english ;
    skos:definition "The dated liveness finding from probing the candidate namespace(s) — the reproducible evidence backing the decline (e.g. an HTTP 404 or an absent per-term RDF surface)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:contentCarriedBy a owl:ObjectProperty ;
    rdfs:label "content carried by"@x-gmeow-english ;
    skos:definition "Links a declined correspondence to the in-slice GMEOW terms that already carry the external vocabulary's distinctions — the positive witness that the declined content is not lost but modelled up, in-slice, making the safety of the decline checkable rather than asserted."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

# --------------------------------------------------------------------------- #
# Catalog family — the registered external target catalogs a grounding
# correspondence may point at.
# --------------------------------------------------------------------------- #
#
# Every `logic:GroundingCorrespondence` names an external `logic:targetEndpoint`.
# The set of external catalogs those endpoints may belong to is CLOSED and
# registered: a target outside every registered family is a HARD FAIL at
# `compile_mappings`, so a new external surface enters the corpus by minting a
# family row rather than by quietly appearing in a bridge cell. The registry also
# carries each family's raise-only correspondence-count ratchet, so an existing
# catalog cannot silently lose rows.
#
# This is DISTINCT from `gmeow:ProjectionVocabulary` (slices/core/slice-quality-rubric),
# which registers the guarded surfaces whose HAND-AUTHORED constructs the
# ungrounded-residue counter caps: that registry looks INWARD at authoring debt in
# `slices/`, this one looks OUTWARD at the alignment targets of the correspondence
# catalog. Their extensions differ (owl:, Wikidata, DLMF, OEIS, the test manifests
# and the schema.org HowTo family are correspondence targets but are deliberately
# NOT guarded residue surfaces), and so do their namespace stems (a family stem
# matches a TARGET IRI, a guarded namespace matches an AUTHORED construct), so
# neither is derivable from the other and neither restates it.

gmeow:CatalogFamily a owl:Class ;
    rdfs:label "external catalog family"@x-gmeow-english ;
    skos:definition "One registered external target catalog a grounding correspondence may point at — a named external formalism (gUFO, BFO, Wikidata, QUDT, OntoLex, BPMN, …) identified by the IRI stem(s) its terms are minted under, together with the grounding slice(s) that author its bridge cells and the raise-only minimum number of correspondences the shipped catalog must carry. It is NOT a gmeow:MappingSet (that is the per-file SSSOM publication header, several of which may target one family, and one of which may span several) and NOT a gmeow:ProjectionVocabulary (that is the inward-looking guarded surface whose hand-authored constructs the residue counter caps): a catalog family classifies the OUTWARD alignment targets, and the registry of families is the closed set a target endpoint must fall in exactly once."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:catalogFamilyName a owl:DatatypeProperty ;
    rdfs:label "catalog family name"@x-gmeow-english ;
    skos:definition "The stable, human-readable identity of a catalog family (\"gUFO\", \"RDF Data Cube\", \"openEHR Task Planning\"), used as the family's key in the gate's ratchet report. Exactly one per family and unique across the registry: two families sharing a name would collapse in the name-keyed count map and hide one catalog's shrinkage behind the other's growth."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:catalogNamespace a owl:DatatypeProperty ;
    rdfs:label "catalog namespace stem"@x-gmeow-english ;
    skos:definition "One IRI stem a member term of this catalog family is minted under; a target endpoint belongs to the family when it starts with any asserted stem. Multi-valued, because a catalog may publish under several bases (OpenMath serves both its http: and https: content-dictionary roots) and because an OBO family is identified by its per-prefix stem (obo/BFO_, obo/STATO_) rather than by the shared obo/ root. At least one is mandatory: a family with no stem could never recognize a target and would be a dead registry row."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:catalogOwner a owl:ObjectProperty ;
    rdfs:label "catalog authoring owner"@x-gmeow-english ;
    skos:definition "A grounding slice (logic:, math:, or lang:) at whose mappings/ boundary this family's bridge cells are authored — the home a domain slice must reference rather than re-align. Multi-valued, and honestly so: a cross-cutting authority such as Wikidata is authored at all three grounding boundaries, and RDFS and OBI at two, so declaring a single owner would be a fiction. At least one is mandatory; an unowned family names no authoring home at all."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:catalogTargetMinimum a owl:DatatypeProperty ;
    rdfs:label "catalog target-count minimum"@x-gmeow-english ;
    skos:definition "The RAISE-ONLY floor on how many shipped grounding correspondences must target this family — the ratchet that turns a silently deleted bridge cell into a red gate. The value may rise as the catalog grows and may never fall while the family is registered; retiring a catalog means removing its family row (and, with it, every correspondence onto it), never lowering the floor to fit a loss. It is NOT a measured count (the gate computes that live from the shipped bundle) and NOT a ceiling (gmeow:ceilingCount is the opposite, lower-only polarity on a residue)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

# --------------------------------------------------------------------------- #
# Residue-ratchet carve-out — the registered, countable exemptions.
# --------------------------------------------------------------------------- #
#
# The projection-vocabulary residue ratchet (docs/PROJECTION-VOCABULARY-RATCHET.md)
# guards a vocabulary only when it has ONE grounding slice as its authoring owner.
# Two registered catalog families the grounding kernel bridges onto — PROV-O and
# schema.org — are general publication vocabularies that ~60 domain slices align to
# as ordinary by-reference correspondences, with no single owner, so they carry no
# `gmeow:ProjectionVocabulary` and their rows enter no residue count, no ceiling,
# and no monotonicity ratchet.
#
# That carve-out used to be a paragraph of prose: nothing counted it, nothing
# bounded it, and rows could be added to it silently and indefinitely. These terms
# make it a REGISTRY ROW like every other governance commitment in this file — a
# typed individual naming the exempted family, stating why it has no owner, and
# pinning how many shipped grounding correspondences currently ride the exemption.
# Growing the carve-out is then an ontology edit that shows up in review, and a row
# added without one reds the mappings stage.

gmeow:ResidueRatchetExemption a owl:Class ;
    rdfs:label "residue-ratchet exemption"@x-gmeow-english ;
    skos:definition "One registered exemption of an external catalog family from the projection-vocabulary residue ratchet — a family whose terms domain slices may align to without an owner boundary, because the family is a general publication vocabulary with no single grounding-slice authoring home. It pairs the exempted gmeow:CatalogFamily with the reason it has no owner and the lower-only ceiling on how many shipped grounding correspondences may ride the exemption. It is NOT a gmeow:ProjectionVocabulary (that is the guarded case, this is the recorded absence of guarding) and NOT a gmeow:ProjectionCeilingCommitment (that caps a measured per-slice residue; this caps the size of the carve-out itself). An exempted family that later gains a single owner must be GUARDED and its exemption removed, never both."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:exemptCatalogFamily a owl:ObjectProperty ;
    rdfs:label "exempted catalog family"@x-gmeow-english ;
    skos:definition "The gmeow:CatalogFamily this exemption covers. Exactly one per exemption, and unique across the registry: two exemptions for one family would each carry half the carve-out's size and hide growth between them. The family must be REGISTERED — an exemption naming no registered family exempts nothing and is a dead row."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:exemptRationale a owl:DatatypeProperty ;
    rdfs:label "exemption rationale"@x-gmeow-english ;
    skos:definition "Why this family has no single grounding-slice owner and therefore cannot be guarded — the substantive argument, not a restatement of the fact. Mandatory: an exemption whose reason is not written down cannot be re-examined by a later reader, which is exactly how an undocumented carve-out becomes permanent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:exemptRowCeiling a owl:DatatypeProperty ;
    rdfs:label "exemption row ceiling"@x-gmeow-english ;
    skos:definition "The LOWER-ONLY ceiling on how many shipped grounding correspondences may target the exempted family — the ratchet that stops the carve-out growing silently. The value may fall as rows are grounded through a guarded owner and may never rise without a deliberate, reviewed ontology edit stating why the carve-out must widen. It has the OPPOSITE polarity to the same family's gmeow:catalogTargetMinimum (which may only rise): together they pin the exempt row count from both sides, so neither a silent addition nor a silent deletion passes."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

# --------------------------------------------------------------------------- #
# Projection profile inventory — the declared consumer down-projection surfaces.
# --------------------------------------------------------------------------- #
#
# A projection profile file under `dsl/mappings/projections/` is a SHIPPED
# CONSUMER SURFACE: its `gmeow:ProjectionMapping` cells are what `gmeow project`
# executes to lower GMEOW data to schema.org, FOAF, DCAT, PROV, … Nothing about a
# generated artifact records that a profile EXISTS — several profiles bind the
# same `gmeow:profile` name and so share one generated `.rq` / `.edoal.ttl` — so
# deleting a profile file, or emptying one of its cells, changed no inventory and
# reddened no gate. This registry closes that: the authored inventory is a second,
# independent source from the directory listing, in the same shape the pipeline's
# `gmeow:expectsGeneratedOutput` inventory is a second source from the carrier's
# emitted set.

gmeow:ProjectionProfile a owl:Class ;
    rdfs:label "projection profile source"@x-gmeow-english ;
    skos:definition "One declared consumer down-projection source file — an authored `dsl/mappings/projections/*.ttl` document of `gmeow:ProjectionMapping` cells, registered with the raise-only floor on how many cells it must declare. It is NOT a gmeow:ProjectionMapping (that is a single cell, many to a profile) and NOT the `gmeow:profile` binding NAME (several profile files may bind the same name and share its generated query): it is the authored FILE, so that removing the file, or hollowing it out, is a countable loss rather than an invisible one."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:profileSource a owl:DatatypeProperty ;
    rdfs:label "projection profile source path"@x-gmeow-english ;
    skos:definition "The repo-relative path of the authored profile document (\"dsl/mappings/projections/schema-org.ttl\"). Exactly one per profile and unique across the inventory; the gate requires the declared path set to EQUAL the on-disk `dsl/mappings/projections/**/*.ttl` set in both directions, so a deleted profile and an unregistered new one are equally hard failures."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:profileCellMinimum a owl:DatatypeProperty ;
    rdfs:label "projection profile cell minimum"@x-gmeow-english ;
    skos:definition "The RAISE-ONLY floor on how many `gmeow:ProjectionMapping` cells the profile document must declare — the ratchet that catches a profile which still parses but has stopped projecting. It may rise as cells are added and may never fall while the profile is registered; retiring a projection surface removes its whole row, never trims the floor to fit a deletion. It is NOT a measured count (the gate counts the authored cells live)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

# --------------------------------------------------------------------------- #
# Pattern fields
# --------------------------------------------------------------------------- #

gmeow:hasMappingPattern a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "has mapping pattern"@x-gmeow-english ;
    skos:definition "Links a projection mapping to its GMEOW-side pattern."@x-gmeow-english .
gmeow:anchor a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "anchor variable"@x-gmeow-english ;
    skos:definition "The name (string) of the variable that the output triple's SUBJECT binds to — the node the projected fact is predicated of (jobTitle on the person, not the Membership)."@x-gmeow-english .
gmeow:value a owl:DatatypeProperty ;
    rdfs:label "value variable"@x-gmeow-english ;
    skos:definition "The name (string) of the variable that the output triple's OBJECT binds to — the projected value."@x-gmeow-english .
gmeow:atom a owl:ObjectProperty ;
    rdfs:label "pattern atom"@x-gmeow-english ;
    skos:definition "An ordered rdf:List of the pattern's atoms (triple/path constraints)."@x-gmeow-english .
gmeow:subjectVar a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "subject variable"@x-gmeow-english ;
    skos:definition "The subject variable name of a pattern/template atom."@x-gmeow-english .
gmeow:predicate a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "atom predicate"@x-gmeow-english ;
    skos:definition "The predicate IRI of a pattern atom (mutually exclusive with gmeow:path)."@x-gmeow-english .
gmeow:predicateVar a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "atom predicate variable"@x-gmeow-english ;
    skos:definition "The predicate variable name of a pattern atom, used when the predicate itself must be constrained by another atom."@x-gmeow-english .
gmeow:path a owl:ObjectProperty ;
    rdfs:label "atom property path"@x-gmeow-english ;
    skos:definition "A structured SPARQL property path (AltPath / SeqPath / ZeroOrMorePath) for a pattern atom whose predicate is not a single IRI."@x-gmeow-english .
gmeow:objectVar a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "object variable"@x-gmeow-english ;
    skos:definition "The object variable name of a pattern atom."@x-gmeow-english .
gmeow:objectValue a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "object value"@x-gmeow-english ;
    skos:definition "A fixed IRI/value-individual on the object side of a pattern atom (e.g. gmeow:eventTypeBirth, gmeow:namePartGiven)."@x-gmeow-english .
gmeow:objectLiteral a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "object literal"@x-gmeow-english ;
    skos:definition "A fixed literal on the object side of a pattern atom (e.g. the boolean false in a displayable check)."@x-gmeow-english .
gmeow:optional a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "optional atom"@x-gmeow-english ;
    skos:definition "When true, the atom is wrapped in OPTIONAL { } in the generated SPARQL."@x-gmeow-english .
gmeow:OptionalGroup a owl:Class ;
    rdfs:label "optional group"@x-gmeow-english ;
    skos:definition "A nested OPTIONAL { … } group of pattern items (atoms or further groups) — needed where a block of constraints is jointly optional (e.g. coordinates with their lat/long sub-optionals)."@x-gmeow-english .
gmeow:optionalGroup a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "optional group items"@x-gmeow-english ;
    skos:definition "The ordered rdf:List of pattern items inside an OPTIONAL group."@x-gmeow-english .
gmeow:suppressWhen a owl:ObjectProperty ;
    rdfs:label "suppress when"@x-gmeow-english ;
    skos:definition "A negative guard atom: the projection is suppressed when this pattern matches, rendered FILTER NOT EXISTS { }. Honours the GMEOW displayable-suppression contract (deadnames / superseded labels are never emitted)."@x-gmeow-english .
gmeow:projectWhen a owl:ObjectProperty ;
    rdfs:label "project when"@x-gmeow-english ;
    skos:definition "A positive guard atom: the projection is emitted ONLY when this pattern matches, rendered FILTER EXISTS { }. The complement of suppressWhen — used for per-consumer gating so that a fact eligible for one consumer is withheld from others, keeping output total and preventing silent disclosure (Principle 10)."@x-gmeow-english .
gmeow:excludeWhen a owl:ObjectProperty ;
    rdfs:label "exclude when"@x-gmeow-english ;
    skos:definition "A negative guard atom on the anchor itself (e.g. exclude FormalLanguage), rendered FILTER NOT EXISTS { }."@x-gmeow-english .
gmeow:filter a owl:ObjectProperty ;
    rdfs:label "boolean filter"@x-gmeow-english ;
    skos:definition "A boolean expression evaluated as a SPARQL FILTER( )."@x-gmeow-english .
gmeow:bind a owl:ObjectProperty ;
    rdfs:label "derived binding"@x-gmeow-english ;
    skos:definition "Binds a variable to a computed expression, rendered BIND( expr AS ?var ) — for composed values (BCP-47, address label)."@x-gmeow-english .
gmeow:mint a owl:ObjectProperty ;
    rdfs:label "minted node"@x-gmeow-english ;
    skos:definition "Binds a variable to a freshly-minted IRI (e.g. a synthetic vcard:Name node), rendered BIND( IRI(...) AS ?var )."@x-gmeow-english .
gmeow:bindVar a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "bound variable"@x-gmeow-english ;
    skos:definition "The name of the variable a bind/mint produces."@x-gmeow-english .
gmeow:bindExpr a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "bind expression"@x-gmeow-english ;
    skos:definition "The expression a bind/mint evaluates."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Profile-binding fields (per-profile fan-out)
# --------------------------------------------------------------------------- #

gmeow:hasBinding a owl:ObjectProperty ;
    rdfs:label "has profile binding"@x-gmeow-english ;
    skos:definition "Links a projection mapping to one of its per-profile bindings."@x-gmeow-english .
gmeow:profile a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "target profile"@x-gmeow-english ;
    skos:definition "The projection profile key: \"schema-org\", \"vcard\", \"foaf\" or \"geosparql\"."@x-gmeow-english .
gmeow:toPredicate a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "target predicate"@x-gmeow-english ;
    skos:definition "The target-vocabulary property the value is emitted under (the simple, single-triple output)."@x-gmeow-english .
gmeow:toClass a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "target class"@x-gmeow-english ;
    skos:definition "The target-vocabulary class the anchor is retyped to (rdf:type output), unconditionally or per a value->class map."@x-gmeow-english .
gmeow:templateAtoms a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "template atoms"@x-gmeow-english ;
    skos:definition "An ordered rdf:List of output (template) atoms for a multi-triple projection — e.g. minting and typing a vcard:Name node. Used in place of toPredicate/toClass for structural outputs."@x-gmeow-english .
gmeow:tSubj a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "template subject"@x-gmeow-english ;
    skos:definition "The subject variable of a template atom."@x-gmeow-english .
gmeow:tPred a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "template predicate"@x-gmeow-english ;
    skos:definition "The target predicate of a template atom."@x-gmeow-english .
gmeow:tObj a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "template object variable"@x-gmeow-english ;
    skos:definition "The object variable of a template atom."@x-gmeow-english .
gmeow:tObjValue a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "template object value"@x-gmeow-english ;
    skos:definition "A fixed IRI on the object side of a template atom (e.g. a target class for an rdf:type triple)."@x-gmeow-english .
gmeow:valueClassMap a owl:ObjectProperty ;
    rdfs:label "value-to-class map"@x-gmeow-english ;
    skos:definition "An ordered rdf:List of (whenValue -> toClass) entries: a source value individual mapped to the target class to assert (rendered a SPARQL VALUES table + N EDOAL AttributeValueRestriction cells)."@x-gmeow-english .
gmeow:whenValue a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "when value"@x-gmeow-english ;
    skos:definition "The source value individual matched by a value-to-class entry (e.g. gmeow:placeTypeCountry)."@x-gmeow-english .
gmeow:relation a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "EDOAL relation"@x-gmeow-english ;
    skos:definition "The EDOAL align:relation string: \"=\" (equivalence), \"<=\" (lossy/subsumed), or \">=\" (subsumes)."@x-gmeow-english .
gmeow:transform a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "transform function"@x-gmeow-english ;
    skos:definition "The FnO projection function this binding invokes (a gmeow:ProjectionFunction)."@x-gmeow-english .
gmeow:edoalSource a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "EDOAL entity1 term"@x-gmeow-english ;
    skos:definition "The salient GMEOW term to use as the EDOAL align:entity1 (e.g. gmeow:fullName for a displayable-name rename). An authored override; when omitted and gmeow:edoalPath is not set, and there is no value->class map, the binding emits no EDOAL cell (a pure structural / SSSOM-backed projection)."@x-gmeow-english .
gmeow:edoalPath a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "derive EDOAL relation path"@x-gmeow-english ;
    skos:definition "When true, the EDOAL align:entity1 is DERIVED as the relation path from the pattern's anchor to its value, expressed with edoal:compose + edoal:inverse (e.g. a birth-event traversal becomes a compose over the principal Participation: inverse(participationParticipant), participationEvent, eventTime). For multi-hop relator/event traversals — makes the EDOAL genuinely declarative rather than a bare class + opaque transform."@x-gmeow-english .
gmeow:edoalSourceKind a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "EDOAL entity1 kind"@x-gmeow-english ;
    skos:definition "Whether the EDOAL entity1 is a \"class\" or a \"relation\" (default \"relation\")."@x-gmeow-english .
gmeow:edoalTarget a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "EDOAL entity2 term"@x-gmeow-english ;
    skos:definition "The target term that is the EDOAL align:entity2, when the output is structural (templateAtoms) rather than a single toPredicate/toClass."@x-gmeow-english .
gmeow:edoalTargetKind a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "EDOAL entity2 kind"@x-gmeow-english ;
    skos:definition "Whether the EDOAL entity2 is a \"class\", \"property\" or \"relation\" (default derived: class for toClass/edoalTarget-class, property for toPredicate)."@x-gmeow-english .
gmeow:lossyDrop a owl:DatatypeProperty ;
    rdfs:label "lossy drop"@x-gmeow-english ;
    skos:definition "A note describing what GMEOW structure this profile drops; aggregated into the generated EDOAL/SPARQL header comments."@x-gmeow-english .
gmeow:emitSssom a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "emit SSSOM row"@x-gmeow-english ;
    skos:definition "When true, this one-to-one term binding also emits an SSSOM row from the binding's source term to its target term (typically gmeow:toPredicate or gmeow:toClass), using gmeow:sssomPredicate for the mapping strength."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Property-path algebra (no raw SPARQL)
# --------------------------------------------------------------------------- #

gmeow:AltPath a owl:Class ;
    rdfs:label "alternative path"@x-gmeow-english ;
    skos:definition "A SPARQL alternative property path p1|p2|… (gmeow:pathAlts)."@x-gmeow-english .
gmeow:SeqPath a owl:Class ;
    rdfs:label "sequence path"@x-gmeow-english ;
    skos:definition "A SPARQL sequence property path p1/p2/… (gmeow:pathSteps)."@x-gmeow-english .
gmeow:ZeroOrMorePath a owl:Class ;
    rdfs:label "zero-or-more path"@x-gmeow-english ;
    skos:definition "A SPARQL zero-or-more property path p* (gmeow:pathStep)."@x-gmeow-english .
gmeow:pathAlts a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "path alternatives"@x-gmeow-english ;
    skos:definition "The ordered rdf:List of alternatives of an AltPath."@x-gmeow-english .
gmeow:pathSteps a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "path steps"@x-gmeow-english ;
    skos:definition "The ordered rdf:List of steps of a SeqPath (each a predicate IRI or a nested path)."@x-gmeow-english .
gmeow:pathStep a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "path step"@x-gmeow-english ;
    skos:definition "The single inner predicate/path of a ZeroOrMorePath / OneOrMorePath / ZeroOrOnePath / InversePath."@x-gmeow-english .
gmeow:InversePath a owl:Class ;
    rdfs:label "inverse path"@x-gmeow-english ;
    skos:definition "A SPARQL inverse property path ^p (gmeow:pathStep) — traverse the relation backwards."@x-gmeow-english .
gmeow:OneOrMorePath a owl:Class ;
    rdfs:label "one-or-more path"@x-gmeow-english ;
    skos:definition "A SPARQL one-or-more property path p+ (gmeow:pathStep)."@x-gmeow-english .
gmeow:ZeroOrOnePath a owl:Class ;
    rdfs:label "zero-or-one path"@x-gmeow-english ;
    skos:definition "A SPARQL zero-or-one (optional) property path p? (gmeow:pathStep)."@x-gmeow-english .
gmeow:NegatedPropertySet a owl:Class ;
    rdfs:label "negated property set"@x-gmeow-english ;
    skos:definition "A SPARQL negated property set !(p1|p2|…) (gmeow:pathSet) — any predicate except the listed ones."@x-gmeow-english .
gmeow:pathSet a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "negated path set"@x-gmeow-english ;
    skos:definition "The ordered rdf:List of predicates excluded by a NegatedPropertySet."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Expression algebra (closed operator set — no raw SPARQL)
# --------------------------------------------------------------------------- #

gmeow:ExpressionOperator a owl:Class ;
    rdfs:label "expression operator"@x-gmeow-english ;
    skos:definition "An operator in the closed SPARQL-expression algebra the compiler renders for composed/derived values."@x-gmeow-english .
gmeow:exprOp a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "expression operator"@x-gmeow-english ;
    skos:definition "The operator applied by an expression node."@x-gmeow-english .
gmeow:exprArgs a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "expression arguments"@x-gmeow-english ;
    skos:definition "The ordered rdf:List of an expression node's arguments (each a nested expression, a gmeow:exprVar node, or a literal/IRI constant)."@x-gmeow-english .
gmeow:exprVar a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:label "expression variable"@x-gmeow-english ;
    skos:definition "A variable reference inside an expression (the variable name as a string)."@x-gmeow-english .

gmeow:opConcat a gmeow:ExpressionOperator ; rdfs:label "CONCAT"@x-gmeow-english ;
    skos:definition "String concatenation of its arguments."@x-gmeow-english .
gmeow:opCoalesce a gmeow:ExpressionOperator ; rdfs:label "COALESCE"@x-gmeow-english ;
    skos:definition "First bound argument (used to default optional address components to empty)."@x-gmeow-english .
gmeow:opIf a gmeow:ExpressionOperator ; rdfs:label "IF"@x-gmeow-english ;
    skos:definition "Ternary conditional IF(cond, then, else)."@x-gmeow-english .
gmeow:opBound a gmeow:ExpressionOperator ; rdfs:label "BOUND"@x-gmeow-english ;
    skos:definition "Whether a variable is bound."@x-gmeow-english .
gmeow:opStr a gmeow:ExpressionOperator ; rdfs:label "STR"@x-gmeow-english ;
    skos:definition "Lexical string of a term."@x-gmeow-english .
gmeow:opIri a gmeow:ExpressionOperator ; rdfs:label "IRI"@x-gmeow-english ;
    skos:definition "Construct an IRI from a string (node minting)."@x-gmeow-english .
gmeow:opStrDatatype a gmeow:ExpressionOperator ; rdfs:label "STRDT"@x-gmeow-english ;
    skos:definition "Tag a lexical string with a datatype IRI (e.g. geo:wktLiteral)."@x-gmeow-english .
gmeow:opRegex a gmeow:ExpressionOperator ; rdfs:label "regex"@x-gmeow-english ;
    skos:definition "Boolean regular-expression match (for primary-subtag filtering)."@x-gmeow-english .

# String / language / datatype functions (rendered NAME(args)).
gmeow:opLang a gmeow:ExpressionOperator ; rdfs:label "LANG"@x-gmeow-english ;
    skos:definition "The language tag of a literal."@x-gmeow-english .
gmeow:opLangMatches a gmeow:ExpressionOperator ; rdfs:label "LANGMATCHES"@x-gmeow-english ;
    skos:definition "Whether a language tag matches a language range."@x-gmeow-english .
gmeow:opStrLang a gmeow:ExpressionOperator ; rdfs:label "STRLANG"@x-gmeow-english ;
    skos:definition "Tag a lexical string with a language tag (preserve a tag on a composed value)."@x-gmeow-english .
gmeow:opDatatype a gmeow:ExpressionOperator ; rdfs:label "DATATYPE"@x-gmeow-english ;
    skos:definition "The datatype IRI of a literal."@x-gmeow-english .
gmeow:opSubstr a gmeow:ExpressionOperator ; rdfs:label "SUBSTR"@x-gmeow-english ;
    skos:definition "Substring extraction SUBSTR(source, start[, length])."@x-gmeow-english .
gmeow:opReplace a gmeow:ExpressionOperator ; rdfs:label "REPLACE"@x-gmeow-english ;
    skos:definition "Regex-based string replacement REPLACE(source, pattern, replacement[, flags])."@x-gmeow-english .
gmeow:opUcase a gmeow:ExpressionOperator ; rdfs:label "UCASE"@x-gmeow-english ;
    skos:definition "Upper-case a string."@x-gmeow-english .
gmeow:opLcase a gmeow:ExpressionOperator ; rdfs:label "LCASE"@x-gmeow-english ;
    skos:definition "Lower-case a string."@x-gmeow-english .
gmeow:opStrBefore a gmeow:ExpressionOperator ; rdfs:label "STRBEFORE"@x-gmeow-english ;
    skos:definition "Substring before the first occurrence of a separator."@x-gmeow-english .
gmeow:opStrAfter a gmeow:ExpressionOperator ; rdfs:label "STRAFTER"@x-gmeow-english ;
    skos:definition "Substring after the first occurrence of a separator."@x-gmeow-english .
gmeow:opStrLen a gmeow:ExpressionOperator ; rdfs:label "STRLEN"@x-gmeow-english ;
    skos:definition "Length of a string."@x-gmeow-english .
gmeow:opContains a gmeow:ExpressionOperator ; rdfs:label "CONTAINS"@x-gmeow-english ;
    skos:definition "Whether a string contains a substring."@x-gmeow-english .
gmeow:opStrStarts a gmeow:ExpressionOperator ; rdfs:label "STRSTARTS"@x-gmeow-english ;
    skos:definition "Whether a string starts with a prefix."@x-gmeow-english .
gmeow:opStrEnds a gmeow:ExpressionOperator ; rdfs:label "STRENDS"@x-gmeow-english ;
    skos:definition "Whether a string ends with a suffix."@x-gmeow-english .
gmeow:opEncodeForUri a gmeow:ExpressionOperator ; rdfs:label "ENCODE_FOR_URI"@x-gmeow-english ;
    skos:definition "Percent-encode a string for use in an IRI."@x-gmeow-english .

gmeow:opDecimal a gmeow:ExpressionOperator ; rdfs:label "xsd:decimal"@x-gmeow-english ;
    skos:definition "Cast a numeric value to canonical xsd:decimal — normalizes a source's scientific-notation xsd:double or bare xsd:integer (e.g. a coordinate 5.35e+01 or 47) to a clean decimal, so projected geographic coordinates carry a consistent, human-readable datatype."@x-gmeow-english .

# Infix operators (rendered (a OP b)). Arithmetic, comparison, boolean.
gmeow:opAdd a gmeow:ExpressionOperator ; rdfs:label "+"@x-gmeow-english ; skos:definition "Numeric addition."@x-gmeow-english .
gmeow:opSub a gmeow:ExpressionOperator ; rdfs:label "-"@x-gmeow-english ; skos:definition "Numeric subtraction."@x-gmeow-english .
gmeow:opMul a gmeow:ExpressionOperator ; rdfs:label "*"@x-gmeow-english ; skos:definition "Numeric multiplication."@x-gmeow-english .
gmeow:opDiv a gmeow:ExpressionOperator ; rdfs:label "/"@x-gmeow-english ; skos:definition "Numeric division."@x-gmeow-english .
gmeow:opEq a gmeow:ExpressionOperator ; rdfs:label "="@x-gmeow-english ; skos:definition "Equality comparison."@x-gmeow-english .
gmeow:opNe a gmeow:ExpressionOperator ; rdfs:label "!="@x-gmeow-english ; skos:definition "Inequality comparison."@x-gmeow-english .
gmeow:opLt a gmeow:ExpressionOperator ; rdfs:label "<"@x-gmeow-english ; skos:definition "Less-than comparison."@x-gmeow-english .
gmeow:opGt a gmeow:ExpressionOperator ; rdfs:label ">"@x-gmeow-english ; skos:definition "Greater-than comparison."@x-gmeow-english .
gmeow:opLe a gmeow:ExpressionOperator ; rdfs:label "<="@x-gmeow-english ; skos:definition "Less-or-equal comparison."@x-gmeow-english .
gmeow:opGe a gmeow:ExpressionOperator ; rdfs:label ">="@x-gmeow-english ; skos:definition "Greater-or-equal comparison."@x-gmeow-english .
gmeow:opAnd a gmeow:ExpressionOperator ; rdfs:label "&&"@x-gmeow-english ; skos:definition "Logical conjunction."@x-gmeow-english .
gmeow:opOr a gmeow:ExpressionOperator ; rdfs:label "||"@x-gmeow-english ; skos:definition "Logical disjunction."@x-gmeow-english .
gmeow:opNot a gmeow:ExpressionOperator ; rdfs:label "!"@x-gmeow-english ; skos:definition "Logical negation (unary)."@x-gmeow-english .
gmeow:opIn a gmeow:ExpressionOperator ; rdfs:label "IN"@x-gmeow-english ;
    skos:definition "Set membership: arg0 IN (arg1, arg2, …)."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Projection functions (FnO source) — label + description + I/O signature.
# The compiler renders these to projections/functions.fno.ttl, DERIVING each
# input parameter's fno:type from the predicate's rdfs:range in the ontology
# (so the fno-type-mismatch bug class is structurally impossible). The output
# type is authored here (projected* predicates have no ontology range).
# --------------------------------------------------------------------------- #

gmeow:ProjectionFunction a owl:Class ;
    rdfs:label "projection function"@x-gmeow-english ;
    skos:definition "Source declaration of an FnO projection transform: its human description and its input predicate(s) + output predicate/type, from which the compiler renders the FnO fno:Function."@x-gmeow-english .
gmeow:fnInput a owl:ObjectProperty ;
    rdfs:label "function input predicate"@x-gmeow-english ;
    skos:definition "A required GMEOW source predicate feeding a projection function; its FnO fno:type is derived from the predicate's rdfs:range."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnInputOptional a owl:ObjectProperty ;
    rdfs:label "optional function input predicate"@x-gmeow-english ;
    skos:definition "An optional GMEOW source predicate feeding a projection function."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnOutput a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "function output predicate"@x-gmeow-english ;
    skos:definition "The FnO output predicate a projection function returns under."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnOutputType a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "function output type"@x-gmeow-english ;
    skos:definition "The authored fno:type of a projection function's output (projected* predicates have no ontology range to derive from)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:fnPlaceTypeToClass a gmeow:ProjectionFunction ;
    rdfs:label "place-type value → target class"@x-gmeow-english ;
    skos:definition "Maps a gmeow:placeType value individual (e.g. placeTypeCountry) to the target vocabulary class to assert via rdf:type (e.g. schema:Country). The conditional retyping; place types without a target class are dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:placeType ;
    gmeow:fnOutput gmeow:projectedType ; gmeow:fnOutputType rdfs:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnLatLongToWktPoint a gmeow:ProjectionFunction ;
    rdfs:label "latitude + longitude → WKT POINT"@x-gmeow-english ;
    skos:definition "Combines separate decimal latitude and longitude into a GeoSPARQL WKT POINT literal (POINT(lon lat), lon first per WKT), typed geo:wktLiteral."@x-gmeow-english ;
    gmeow:fnInput gmeow:latitude , gmeow:longitude ;
    gmeow:fnOutput geo:asWKT ; gmeow:fnOutputType geo:wktLiteral ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnPosePositionToWktPoint a gmeow:ProjectionFunction ;
    rdfs:label "pose position → WKT POINT"@x-gmeow-english ;
    skos:definition "Projects the translational component of a gmeow:Pose (reached via gmeow:hasPosePosition as SpatialCoordinates) to a GeoSPARQL WKT POINT literal. The orientation component is dropped because GeoSPARQL 1.0/1.1 has no native pose model; heading/bearing may be projected separately to a future GeoPose JSON profile."@x-gmeow-english ;
    gmeow:fnInput gmeow:latitude , gmeow:longitude ;
    gmeow:fnOutput geo:asWKT ; gmeow:fnOutputType geo:wktLiteral ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnCoarsenToGranularity a gmeow:ProjectionFunction ;
    rdfs:label "coarsen coordinates to the enclosing region (generalization, Principle 10)"@x-gmeow-english ;
    skos:definition "Disclosure control by generalization (Principle 10): a place that carries gmeow:coarsenTo a target gmeow:GranularityLevel is projected with the coordinates of the enclosing ancestor at that level INSTEAD of its precise point — a coarser region rather than exact coordinates, never deletion. Aligns by reference to dpv:Generalisation. Ancestor SELECTION is performed declaratively in the SPARQL projection (the gmeow:containedInPlace+ path matching the ancestor whose gmeow:hasGranularity is the target level); this transform documents the resulting generalization, receiving the already-selected ancestor's coordinates (paramLatitude/paramLongitude) and re-emitting them as the place's location. Heavier geomasking / k-anonymity stays in the solver layer (Principle 12)."@x-gmeow-english ;
    gmeow:fnInput gmeow:coarsenTo , gmeow:latitude , gmeow:longitude ;
    gmeow:fnOutput geo:asWKT ; gmeow:fnOutputType geo:wktLiteral ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnRetagWkt a gmeow:ProjectionFunction ;
    rdfs:label "retag WKT literal as geo:wktLiteral"@x-gmeow-english ;
    skos:definition "Re-tags a gmeow:asWKT value (range rdfs:Literal, for OWL 2 DL safety) with the geo:wktLiteral datatype so GeoSPARQL spatial engines recognise it."@x-gmeow-english ;
    gmeow:fnInput gmeow:asWKT ;
    gmeow:fnOutput geo:asWKT ; gmeow:fnOutputType geo:wktLiteral ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnRetagGeoJson a gmeow:ProjectionFunction ;
    rdfs:label "retag GeoJSON literal as geo:geoJSONLiteral"@x-gmeow-english ;
    skos:definition "Re-tags a gmeow:asGeoJSON value (range rdfs:Literal, for OWL 2 DL safety) with the geo:geoJSONLiteral datatype so GeoSPARQL spatial engines recognise it."@x-gmeow-english ;
    gmeow:fnInput gmeow:asGeoJSON ;
    gmeow:fnOutput geo:asGeoJSON ; gmeow:fnOutputType geo:geoJSONLiteral ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnCoarsenToGranularityGeoJson a gmeow:ProjectionFunction ;
    rdfs:label "coarsen GeoJSON coordinates to the enclosing region (generalization, Principle 10)"@x-gmeow-english ;
    skos:definition "Disclosure control by generalization (Principle 10): a place that carries gmeow:coarsenTo a target gmeow:GranularityLevel is projected with the coordinates of the enclosing ancestor at that level INSTEAD of its precise GeoJSON — a coarser region rather than exact coordinates, never deletion. Receives the already-selected ancestor's GeoJSON and re-emitting it as the place's location. Heavier geomasking / k-anonymity stays in the solver layer (Principle 12)."@x-gmeow-english ;
    gmeow:fnInput gmeow:coarsenTo , gmeow:asGeoJSON ;
    gmeow:fnOutput geo:asGeoJSON ; gmeow:fnOutputType geo:geoJSONLiteral ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnComposeAddress a gmeow:ProjectionFunction ;
    rdfs:label "compose address components → single label string"@x-gmeow-english ;
    skos:definition "Concatenates the decomposed address components (street, locality, region, postal code, country) into one single-line label string — emitted as vcard:label by the vCard projection. Lossy: formatting convention varies by locale."@x-gmeow-english ;
    gmeow:fnInputOptional gmeow:streetAddress , gmeow:addressLocality , gmeow:addressRegion , gmeow:postalCode , gmeow:countryCode ;
    gmeow:fnOutput gmeow:projectedAddress ; gmeow:fnOutputType xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnSelectDisplayName a gmeow:ProjectionFunction ;
    rdfs:label "select displayable full name"@x-gmeow-english ;
    skos:definition "Returns an appellation's gmeow:fullName ONLY when gmeow:displayable is not false (deadnames and superseded names are suppressed). Co-equal: every displayable name is emitted; none is privileged as 'primary' — locale-relative selection is left to the consumer."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasAppellation ;
    gmeow:fnOutput gmeow:projectedName ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnSelectEndonym a gmeow:ProjectionFunction ;
    rdfs:label "select displayable endonym place name → schema:name"@x-gmeow-english ;
    skos:definition "Returns the gmeow:fullName of a place's gmeow:PlaceName whose gmeow:namePurpose is gmeow:namePurposeEndonym and which is not gmeow:displayable false — the locale-internal toponym, emitted as schema:name. A projection FRAME choice (endonym-preferred), NOT a primary-name assertion in the canonical model: co-equal exonyms are emitted as schema:alternateName (gmeow:fnSelectExonym), and historical/superseded and competing-standpoint names are dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasPlaceName ;
    gmeow:fnOutput gmeow:projectedEndonym ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnSelectExonym a gmeow:ProjectionFunction ;
    rdfs:label "select displayable exonym place name → schema:alternateName"@x-gmeow-english ;
    skos:definition "Returns the gmeow:fullName of a place's gmeow:PlaceName whose gmeow:namePurpose is gmeow:namePurposeExonym and which is not gmeow:displayable false — a name used from outside, emitted as schema:alternateName alongside the endonym selected as schema:name (gmeow:fnSelectEndonym). Lossy: which exonym applies is locale-relative (there may be one per language), and historical/superseded names are dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasPlaceName ;
    gmeow:fnOutput gmeow:projectedExonym ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnSelectDisplayableGender a gmeow:ProjectionFunction ;
    rdfs:label "select displayable gender identity → gender label"@x-gmeow-english ;
    skos:definition "Returns the rdfs:label of a person's displayable gmeow:GenderIdentity value for emission as schema:gender / foaf:gender. A gmeow:displayable false facet is NEVER emitted — the same suppression contract as a deadname. Lossy and directional: schema.org/FOAF conflate sex and gender, and orientation + sex-assigned-at-birth have no target term, so they are dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasGenderIdentity ;
    gmeow:fnOutput gmeow:projectedGender ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnHonorificToAffix a gmeow:ProjectionFunction ;
    rdfs:label "honorific value → prefix/suffix literal"@x-gmeow-english ;
    skos:definition "Maps a gmeow:Honorific value to a target honorific-prefix or honorific-suffix string according to its gmeow:honorificPosition (e.g. honorificDr → schema:honorificPrefix \"Dr\"; honorificSan → a suffix)."@x-gmeow-english ;
    gmeow:fnInput gmeow:honorific ;
    gmeow:fnOutput gmeow:projectedAffix ; gmeow:fnOutputType xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnPronounSetToText a gmeow:ProjectionFunction ;
    rdfs:label "pronoun set → full five-form declension text"@x-gmeow-english ;
    skos:definition "Renders a gmeow:PronounSet's full five-form declension as a single slash-joined string (subject/object/possessive-determiner/possessive/reflexive, e.g. 'she/her/her/hers/herself', 'xe/xem/xyr/xyrs/xemself') for emission as the vCard 4 PRONOUNS property (RFC 9554, free text), carried on the GMEOW-minted vcardx:pronouns extension term because the W3C vCard RDF ontology never minted a predicate for it. Because PRONOUNS is free text it carries the whole declension LOSSLESSLY — no form is dropped, and a consumer can reconstruct the full set. The only non-representable parts are the non-specifying values (pronounAny / pronounAsk / pronounNameOnly, which carry no forms) and any period / standpoint on the assertion."@x-gmeow-english ;
    gmeow:fnInput gmeow:pronounSubject , gmeow:pronounObject , gmeow:pronounPossessiveDeterminer , gmeow:pronounPossessive , gmeow:pronounReflexive ;
    gmeow:fnOutput gmeow:projectedPronouns ; gmeow:fnOutputType xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnComposeBcp47 a gmeow:ProjectionFunction ;
    rdfs:label "compose BCP-47 language tag"@x-gmeow-english ;
    skos:definition "Composes a BCP-47 language tag from a language's gmeow:languageCode and (optionally) the ISO 15924 script subtag of a co-mingled orthography's lang:Script — the script's skos:notation, reached through lang:orthographyFor + lang:usesScript (\"ja\" + \"Hani\" → \"ja-Hani\"). The registry tag GMEOW refuses as identity, reconstructed on demand for schema.org consumers and emitted as schema:alternateName. A language with several orthographies yields several tags."@x-gmeow-english ;
    gmeow:fnInput gmeow:languageCode ;
    gmeow:fnOutput gmeow:projectedLanguageTag ; gmeow:fnOutputType xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnProficiencyToKnownLanguage a gmeow:ProjectionFunction ;
    rdfs:label "flatten LanguageProficiency → schema:knowsLanguage"@x-gmeow-english ;
    skos:definition "Flattens the reified gmeow:LanguageProficiency relator (agent × language × modality × level) and the flat gmeow:knowsLanguage to schema:knowsLanguage(agent, language). Lossy: the CEFR/ILR/ACTFL level and skill modality are dropped — schema.org has no proficiency model."@x-gmeow-english ;
    gmeow:fnInput gmeow:proficiencyLanguage ;
    gmeow:fnOutput gmeow:projectedKnownLanguage ; gmeow:fnOutputType gmeow:Language ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnNicknameName a gmeow:ProjectionFunction ;
    rdfs:label "nickname-purpose PersonName → foaf:nick"@x-gmeow-english ;
    skos:definition "Returns the gmeow:fullName of a PersonName whose gmeow:namePurpose is gmeow:namePurposeNickname, for emission as foaf:nick / vcard:nickname / schema:alternateName. The nickname is a structured name in GMEOW; this downcasts it to the flat nick field."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasName ;
    gmeow:fnOutput gmeow:projectedNick ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnBirthEventToDate a gmeow:ProjectionFunction ;
    rdfs:label "Birth life-event → schema:birthDate"@x-gmeow-english ;
    skos:definition "Extracts a person's birth date by traversing the reified event model: an event with gmeow:eventType gmeow:eventTypeBirth, whose principal Participation (gmeow:participationRole gmeow:roleParticipantPrincipal, gmeow:participationParticipant ?person) and gmeow:eventTime yield ?person schema:birthDate. GMEOW models birth as an event (with place, sources, confidence, participant roles); this downcasts the event's instant to the flat schema:birthDate / vCard BDAY field."@x-gmeow-english ;
    gmeow:fnInput gmeow:eventTime ;
    gmeow:fnOutput gmeow:projectedBirthDate ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnMembershipToJobTitle a gmeow:ProjectionFunction ;
    rdfs:label "Membership + Role → schema:jobTitle"@x-gmeow-english ;
    skos:definition "Extracts a job title by traversing the reified relator: a gmeow:Membership (gmeow:membershipMember ?person, gmeow:hasRole ?role) yields ?person schema:jobTitle = the role's label. GMEOW models a job as a role played in a membership; this downcasts the role label to the flat schema:jobTitle / vCard TITLE field."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasRole ;
    gmeow:fnOutput gmeow:projectedJobTitle ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnSubOrgToDepartment a gmeow:ProjectionFunction ;
    rdfs:label "subOrganizationOf → schema:department"@x-gmeow-english ;
    skos:definition "Projects org hierarchy: a gmeow:Organization that is gmeow:subOrganizationOf a parent is emitted as the parent's schema:department (parent→child, the inverse direction). The department is a first-class sub-organization in GMEOW."@x-gmeow-english ;
    gmeow:fnInput gmeow:subOrganizationOf ;
    gmeow:fnOutput gmeow:projectedDepartment ; gmeow:fnOutputType gmeow:Organization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnWebPageToUrl a gmeow:ProjectionFunction ;
    rdfs:label "hasWebPage → schema:url"@x-gmeow-english ;
    skos:definition "Projects an entity's structured web presence: gmeow:hasWebPage points to a first-class gmeow:WebPage whose IRI is its URL, emitted as schema:url / foaf:homepage on the entity. Downcasts the structured page resource to the flat URL field."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasWebPage ;
    gmeow:fnOutput gmeow:projectedUrl ; gmeow:fnOutputType xsd:anyURI ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnParticipationToEventRole a gmeow:ProjectionFunction ;
    rdfs:label "Participation → schema event-role edge"@x-gmeow-english ;
    skos:definition "Downcasts a reified gmeow:Participation to a flat schema.org event-role edge: the event gains schema:attendee / schema:performer / schema:organizer pointing at the participant, keyed by the participation's gmeow:ParticipantRole. The Participation's period, confidence, evidence and standpoint, and the open role space beyond the three schema roles, are dropped — the flat edge is lossy by design."@x-gmeow-english ;
    gmeow:fnInput gmeow:participationParticipant ;
    gmeow:fnOutput gmeow:projectedEventRole ; gmeow:fnOutputType gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnFuzzyTimeToDate a gmeow:ProjectionFunction ;
    rdfs:label "fuzzy event bounds → schema:startDate"@x-gmeow-english ;
    skos:definition "Downcasts an approximate (circa) event date to a single schema:startDate: the gmeow:earliestStart lower bound is emitted, while the gmeow:latestEnd upper bound and the gmeow:temporalPrecision qualifier are dropped — the uncertainty band collapses to one instant."@x-gmeow-english ;
    gmeow:fnInput gmeow:earliestStart ;
    gmeow:fnOutput gmeow:projectedFuzzyDate ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnEventTypeToSummary a gmeow:ProjectionFunction ;
    rdfs:label "event type label → iCalendar SUMMARY"@x-gmeow-english ;
    skos:definition "Downcasts an event's open gmeow:eventType vocabulary to a single human-readable iCalendar SUMMARY: the rdfs:label of a gmeow:EventType value is emitted as ical:summary. The full multi-type richness collapses to one title string."@x-gmeow-english ;
    gmeow:fnInput gmeow:eventType ;
    gmeow:fnOutput gmeow:projectedSummary ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnParticipantToAttendee a gmeow:ProjectionFunction ;
    rdfs:label "hasParticipant → iCalendar ATTENDEE"@x-gmeow-english ;
    skos:definition "Downcasts the flat gmeow:hasParticipant shortcut to a bare iCalendar ATTENDEE edge: the participant agent is emitted as ical:attendee on the event. Any reified Participation's role, period, confidence and standpoint are dropped — iCal's ATTENDEE carries none of them."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasParticipant ;
    gmeow:fnOutput gmeow:projectedAttendee ; gmeow:fnOutputType gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnTagToKeyword a gmeow:ProjectionFunction ;
    rdfs:label "tag label → schema:keywords text"@x-gmeow-english ;
    skos:definition "Extracts the rdfs:label of a gmeow:Tag pointed at by gmeow:hasTag for emission as schema:keywords. Suppresses tags whose gmeow:displayable is false (the same suppression contract as deadnames). Lossy: the tag IRI is lost; only the surface label survives."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasTag ;
    gmeow:fnOutput gmeow:projectedTagKeyword ; gmeow:fnOutputType xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnTaggingToAnnotation a gmeow:ProjectionFunction ;
    rdfs:label "reshape Tagging relator → oa:Annotation"@x-gmeow-english ;
    skos:definition "Reshapes a reified gmeow:Tagging relator into a W3C Web Annotation (oa:Annotation): the tagged entity becomes oa:hasTarget, the tag becomes oa:hasBody, and oa:motivatedBy is set to oa:tagging. The tagger (gmeow:taggingTagger / gmeow:wasAttributedTo) and temporal scope (gmeow:taggingInterval) are lossy-dropped in the structural projection; a consumer that needs them should use the canonical GMEOW model directly."@x-gmeow-english ;
    gmeow:fnInput gmeow:taggingTagged , gmeow:taggingTag ;
    gmeow:fnInputOptional gmeow:taggingTagger , gmeow:wasAttributedTo , gmeow:taggingInterval ;
    gmeow:fnOutput gmeow:projectedAnnotation ; gmeow:fnOutputType oa:Annotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnLatLongToGeoUri a gmeow:ProjectionFunction ;
    rdfs:label "latitude + longitude → geo: URI (RFC 5870)"@x-gmeow-english ;
    skos:definition "Composes separate decimal latitude and longitude into a geo: URI (RFC 5870, e.g. geo:53.544972,-113.924398). The URI identifies a geographic point independent of any particular serialization format (WKT, GeoJSON, vCard GEO, …). Used as the minted node IRI for vCard Geo projections and as a canonical, dereferenceable location identifier."@x-gmeow-english ;
    gmeow:fnInput gmeow:latitude , gmeow:longitude ;
    gmeow:fnOutput gmeow:projectedGeoUri ; gmeow:fnOutputType xsd:anyURI ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnStandpointDivergence a gmeow:ProjectionFunction ;
    rdfs:label "held + projected standpoint → divergence text"@x-gmeow-english ;
    skos:definition "Computes the divergence between a held standpoint and a projected standpoint as a human-readable text. Lossy: the full semantic content of each standpoint is collapsed to a single divergence description."@x-gmeow-english ;
    gmeow:fnInput gmeow:heldStandpoint , gmeow:projectedStandpoint ;
    gmeow:fnOutput gmeow:projectedDivergence ; gmeow:fnOutputType xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnImplicatesInContext a gmeow:ProjectionFunction ;
    rdfs:label "implicates → contextual implication text"@x-gmeow-english ;
    skos:definition "Projects an event's implicature relation to a contextual implication text. The paltering mechanism — a literally true statement that misleadingly implies a false conclusion. Lossy: the full implicature chain is collapsed to a single text string."@x-gmeow-english ;
    gmeow:fnInput gmeow:implicates ;
    gmeow:fnOutput gmeow:projectedImplication ; gmeow:fnOutputType xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnMaximViolationType a gmeow:ProjectionFunction ;
    rdfs:label "maxim violation → violation type label"@x-gmeow-english ;
    skos:definition "Projects a maxim violation to a violation type label. Solver-layer computation (Principle 12). Lossy: the full conversational context is dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:maximViolationType ;
    gmeow:fnOutput gmeow:projectedMaximViolation ; gmeow:fnOutputType xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnDeceptionCueScore a gmeow:ProjectionFunction ;
    rdfs:label "deception cue → cue score"@x-gmeow-english ;
    skos:definition "Projects a deception cue observation to a numerical cue score. The scoring and weighting of cues is solver-layer (Principle 12). Lossy: the full observation metadata is dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:deceptionCue ;
    gmeow:fnOutput gmeow:projectedCueScore ; gmeow:fnOutputType xsd:decimal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnCredibilityScore a gmeow:ProjectionFunction ;
    rdfs:label "credibility → score"@x-gmeow-english ;
    skos:definition "Projects a credibility assessment to a numerical score. Solver-layer computation (Principle 12). Lossy: the full evidentiary basis is dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:credibilityScore ;
    gmeow:fnOutput gmeow:projectedCredibility ; gmeow:fnOutputType xsd:decimal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnPropagationMutationDistance a gmeow:ProjectionFunction ;
    rdfs:label "propagation mutation distance → integer"@x-gmeow-english ;
    skos:definition "Projects the mutation distance of a propagated deceptive claim to an integer count. Measures how many hops/transmissions before the claim mutates. Solver-layer computation (Principle 12)."@x-gmeow-english ;
    gmeow:fnInput gmeow:propagationMutationDistance ;
    gmeow:fnOutput gmeow:projectedMutationDistance ; gmeow:fnOutputType xsd:integer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnArgumentAcceptability a gmeow:ProjectionFunction ;
    rdfs:label "argument acceptability → score"@x-gmeow-english ;
    skos:definition "Projects an argument's acceptability to a numerical score. Solver-layer computation (Principle 12), referencing AIF (Argument Interchange Format). Lossy: the full argument structure is dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:argumentAcceptability ;
    gmeow:fnOutput gmeow:projectedAcceptability ; gmeow:fnOutputType xsd:decimal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnComposeMailmapMapping a gmeow:ProjectionFunction ;
    rdfs:label "compose canonical + old bytes → .mailmap mapping line"@x-gmeow-english ;
    skos:definition "Composes a .mailmap mapping line for a superseded AuthorIdentity: CONCAT(canonical mailmapEntry, ' ', old authorIdentityString). This is the suppression projection — the old identity is retained in the graph but remapped in the generated .mailmap (Principle 10)."@x-gmeow-english ;
    gmeow:fnInput gmeow:mailmapEntry , gmeow:authorIdentityString ;
    gmeow:fnOutput gmeow:projectedMailmapMapping ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnOrganizationTypeToClass a gmeow:ProjectionFunction ;
    rdfs:label "organization-type value → target class"@x-gmeow-english ;
    skos:definition "Maps a gmeow:organizationType value individual (e.g. organizationTypeCompany) to the target vocabulary class to assert via rdf:type (e.g. schema:Corporation). The conditional retyping; organization types without a target class are dropped."@x-gmeow-english ;
    gmeow:fnInput gmeow:organizationType ;
    gmeow:fnOutput gmeow:projectedType ; gmeow:fnOutputType rdfs:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


gmeow:fnPostToOrganizationRole a gmeow:ProjectionFunction ;
    rdfs:label "Post + Role → schema:roleName (lossy)"@x-gmeow-english ;
    skos:definition "Extracts a role name by traversing the Post: a gmeow:Post (gmeow:postIn ?org, filled by gmeow:Membership gmeow:hasRole ?role) yields the role's label as schema:roleName. GMEOW models a post as a seat independent of its holder; this downcasts the role label to the flat schema:roleName field, collapsing the seat/holder distinction."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasRole ;
    gmeow:fnOutput gmeow:projectedRoleName ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .


# Backfilled annotations for the annotation-completeness gate.
gmeow:AltPath rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:ExpressionOperator rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:InversePath rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:MappingPattern rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:MappingSet rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:NegatedPropertySet rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:OneOrMorePath rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:OptionalGroup rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:PatternAtom rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:ProfileBinding rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:ProjectionFunction rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:ProjectionMapping rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

