PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:stateHasVelocity        rdfs:range math:Quantity .
    gmeow:stateHasAngularVelocity rdfs:range math:Quantity .
}""" ;
    gmeow:saRationale "gmeow:stateHasVelocity and stateHasAngularVelocity MUST range over math:Quantity." .

# --- 51. hasTrajectorySample is NOT functional (MUST-NOT) ---------------------
ex:saHasTrajectorySampleNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
