@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix bibframe: <http://id.loc.gov/ontologies/bibframe/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/bibframe>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Work ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri bibframe:Work ;
        ] ;
        align:relation "=" ;
        edoal:measure "0.9"^^xsd:double ;
        rdfs:label "Work → bf:Work"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasTitle ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri bibframe:title ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "CreativeWorkTitle relator → bf:Title node"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:identifier ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri bibframe:identifiedBy ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "non-DOI identifier → bf:identifiedBy minted bf:Identifier node"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:identifier ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri bibframe:identifiedBy ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "DOI identifier → bf:identifiedBy minted bf:Doi node"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:title ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri bibframe:title ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "title → bf:title"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "bibframe" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → bibframe (EDOAL)"@en .
