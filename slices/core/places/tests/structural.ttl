    gmeow:saRationale "gmeow:trajectoryOf MUST be owl:FunctionalProperty. Mirrors test_trajectory_of_is_functional." .

# --- 57. No preferred/primary stream terms (MUST-NOT) -------------------------
ex:saNoPreferredPrimaryStreamTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:primaryStream gmeow:preferredStream
        gmeow:primaryLocationStream gmeow:preferredLocationStream
    }
    VALUES ?t {
        owl:ObjectProperty owl:DatatypeProperty
        owl:AnnotationProperty owl:Class
    }
    ?banned a ?t .
}""" ;
    gmeow:saRationale "No preferred*/primary* stream selectors MUST NOT exist (Principle 9, co-equality). Mirrors test_no_preferred_stream_term." .

# --- 58. Capacity/Occupancy/Utilization subclass Measurement (MUST) -----------
ex:saCapacityOccupancyUtilizationSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Capacity    a owl:Class ; rdfs:subClassOf gmeow:Measurement .
    gmeow:Occupancy   a owl:Class ; rdfs:subClassOf gmeow:Measurement .
    gmeow:Utilization a owl:Class ; rdfs:subClassOf gmeow:Measurement .
}""" ;
    gmeow:saRationale "gmeow:Capacity, Occupancy, and Utilization MUST be owl:Class and rdfs:subClassOf gmeow:Measurement. Mirrors test_capacity_occupancy_utilization_subclass_of_measurement." .

# --- 59. capacityOf is functional with domain/range/subPropertyOf (MUST) ------
ex:saCapacityOfShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:capacityOf a owl:FunctionalProperty ;
        rdfs:domain gmeow:Capacity ;
        rdfs:range  gmeow:Location ;
        rdfs:subPropertyOf gmeow:observedFeature .
}""" ;
    gmeow:saRationale "gmeow:capacityOf MUST be functional with domain Capacity, range Location, and rdfs:subPropertyOf observedFeature. Mirrors test_capacity_of_property." .

# --- 60. occupancyOf is functional with domain/range/subPropertyOf (MUST) -----
ex:saOccupancyOfShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:occupancyOf a owl:FunctionalProperty ;
        rdfs:domain gmeow:Occupancy ;
        rdfs:range  gmeow:Location ;
        rdfs:subPropertyOf gmeow:observedFeature .
}""" ;
    gmeow:saRationale "gmeow:occupancyOf MUST be functional with domain Occupancy, range Location, and rdfs:subPropertyOf observedFeature. Mirrors test_occupancy_of_property." .

# --- 61. utilizationOf is functional with domain/range/subPropertyOf (MUST) ---
ex:saUtilizationOfShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:utilizationOf a owl:FunctionalProperty ;
        rdfs:domain gmeow:Utilization ;
        rdfs:range  gmeow:Location ;
        rdfs:subPropertyOf gmeow:observedFeature .
}""" ;
    gmeow:saRationale "gmeow:utilizationOf MUST be functional with domain Utilization, range Location, and rdfs:subPropertyOf observedFeature. Mirrors test_utilization_of_property." .

