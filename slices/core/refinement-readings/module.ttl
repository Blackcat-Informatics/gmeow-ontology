    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:reading gmeow:openItemAt \"2026-10-01T09:00:00Z\"^^xsd:dateTime ."@x-gmeow-english .

gmeow:RecurrenceReading
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Refinement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Recurrence Reading"@x-gmeow-english ;
    skos:definition "A versioned process’s reading of repeated appearances of one related resource within offered records and an optional supplied settling boundary. It asserts no motive, preference or global absence of settlement."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:reading a gmeow:RecurrenceReading ."@x-gmeow-english .

gmeow:HabitFigure
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Refinement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Habit Figure"@x-gmeow-english ;
    skos:definition "A versioned process’s reported activity counts over offered acts, under a named holder’s day-part reckoning and temporal frame. The figure is neither a preference judgment nor a diagnosis of habit."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:reading a gmeow:HabitFigure ."@x-gmeow-english .

gmeow:habitChosenCount
    a logic:DatatypeProperty ;
    logic:domain gmeow:HabitFigure ;
    logic:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported chosen count"@x-gmeow-english ;
    skos:definition "The source-reported nonnegative count of choices for the selected activity in this figure’s scope. Its denominator and grouping belong to the consumer’s declared reporting method, not to an implicit inequality."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:reading gmeow:habitChosenCount \"0\"^^xsd:nonNegativeInteger ."@x-gmeow-english .

gmeow:habitSituationCount
    a logic:DatatypeProperty ;
    logic:domain gmeow:HabitFigure ;
    logic:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported situation count"@x-gmeow-english ;
    skos:definition "The source-reported nonnegative count of situations considered for this figure. It does not define a denominator relationship to habitChosenCount or imply which situations were eligible."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:reading gmeow:habitSituationCount \"0\"^^xsd:nonNegativeInteger ."@x-gmeow-english .

